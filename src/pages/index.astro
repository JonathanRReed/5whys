---
import HomeSpecimen from '../components/HomeSpecimen';
import Base from '../layouts/Base.astro';
import { hasWages } from '../config/pay';
import { siteConfig } from '../config/site';

const privacyChips = ['No account', 'Local-only', 'Open source', 'Free'];

// Examples show how to use each tool without promising a score or outcome.
const plates = [
  {
    roman: 'I',
    tag: 'Plate I · Reflect',
    accent: 'foam',
    name: 'The Five Whys',
    href: '/career/',
    desc: 'Explore what matters in your next step. Treat the answers as a working hypothesis you can test.',
    caption: 'Example · a reason to explore',
  },
  {
    roman: 'II',
    tag: 'Plate II · Prove',
    accent: 'gold',
    name: 'The Resume Game',
    href: '/resume-game/',
    desc: 'Review unclear lines, missing context, and evidence you can strengthen. Keep what is already working.',
    caption: 'Example · one line to review',
  },
  {
    roman: 'III',
    tag: 'Plate III · Rehearse',
    accent: 'iris',
    name: 'Networking Practice',
    href: '/networking-practice/',
    desc: 'Rehearse real introductions against a timer, then debrief each rep so the next conversation feels lighter.',
    caption: 'Example · a practice introduction',
  },
  {
    roman: 'IV',
    tag: 'Plate IV · Prepare',
    accent: 'love',
    name: 'Interview Glow Up',
    href: '/interview-glow-up/',
    desc: 'Find likely interview themes in a job description, then connect them to stories you can support.',
    caption: 'Example · a theme to prepare',
  },
  {
    roman: 'V',
    tag: 'Plate V · Apply',
    accent: 'lichen',
    name: 'The Application Desk',
    href: '/application/',
    desc: 'Paste a posting once. Sort what it asks for, mark where you stand, write two bullets and a letter, and check it before you send.',
    caption: 'Example · a requirement, sorted',
  },
  {
    roman: 'VI',
    tag: 'Plate VI · Weigh',
    accent: 'madder',
    name: 'Pay',
    href: '/pay/',
    // Wage figures ship only once the public wage files have been built in.
    desc: hasWages
      ? 'See what an occupation tends to pay, as dated percentiles from public wage data, and put an offer into terms you can compare.'
      : 'Put an offer into terms you can compare: by the hour, the week and the year, with overtime and bonus counted.',
    caption: 'Example · an offer, in plain terms',
  },
];

// The way in, in the visitor's words. Each opens its tool with the guide on,
// so a first visit starts with a hand on the shoulder.
const situations = [
  {
    say: 'I found a job I want to apply for.',
    get: 'Leave with what it asks for, a resume for it, and a letter.',
    tool: 'The Application Desk',
    href: '/application/?guide=1',
    accent: 'lichen',
  },
  {
    say: 'My resume is not getting replies.',
    get: 'See it the way a hiring system reads it, and fix the weak lines.',
    tool: 'The Resume Game',
    href: '/resume-game/?guide=1',
    accent: 'gold',
  },
  {
    say: 'I have an interview coming up.',
    get: 'Answer the likely questions out loud and hear yourself back.',
    tool: 'Interview Glow Up',
    href: '/interview-glow-up/rehearse/?guide=1',
    accent: 'love',
  },
  {
    say: 'I freeze when I have to introduce myself.',
    get: 'Practice a thirty-second introduction until it sounds like you.',
    tool: 'Networking Practice',
    href: '/networking-practice/?guide=1',
    accent: 'iris',
  },
  {
    say: 'I got an offer and cannot tell if it is good.',
    get: 'Put it into plain hourly, weekly and yearly terms.',
    tool: 'Pay',
    href: '/pay/?guide=1',
    accent: 'madder',
  },
  {
    say: 'I do not know what I want next.',
    get: 'Ask why five times and find the reason under the first answer.',
    tool: 'The Five Whys',
    href: '/career/?guide=1',
    accent: 'foam',
  },
];

const fieldNotes = [
  {
    k: 'It talks to no one else',
    v: 'Open your browser\'s network panel and use any tool. Every request goes to this site and nowhere else: no analytics, no trackers, no AI service.',
    c: 'foam',
  },
  {
    k: 'No account, no cookies',
    v: 'There is nothing to sign up for. What you write is saved on this device, and one file from the dashboard moves it to another.',
    c: 'gold',
  },
  {
    k: 'Gone when you say so',
    v: 'The dashboard shows what is stored and deletes all of it in one press, which matters on a shared or library computer.',
    c: 'iris',
  },
];

const toolkitItems = plates.map((p) => ({
  name: p.name,
  description: p.desc,
  url: p.href,
}));

const homeStructuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: '5 Whys Career Studio',
    url: siteConfig.siteUrl,
    description:
      'Private browser tools for career reflection, resume polish, networking practice, and interview prep by Jonathan R. Reed.',
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: 'Career field guide plates',
    itemListElement: toolkitItems.map((item, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: item.name,
      description: item.description,
      url: new URL(item.url, siteConfig.siteUrl).toString(),
    })),
  },
];
---

<Base
  title="5 Whys Career Studio | A field guide to professional life"
  description="Private browser tools for career reflection, resume polish, networking practice, and interview prep by Jonathan R. Reed."
  structuredData={homeStructuredData}
>
  <div class="relative space-y-24 overflow-hidden px-4 pb-24 pt-8 sm:space-y-28 sm:pt-10">
    {/* ============================ MASTHEAD ============================ */}
    <div class="fg-rise mx-auto w-full max-w-6xl" style="animation-delay:0.05s">
      <div class="rule-double mb-3"></div>
      <div
        class="flex flex-wrap items-center justify-between gap-x-6 gap-y-1 text-muted-foreground"
      >
        <span class="eyebrow">5 Whys Career Studio</span>
        <span class="eyebrow hidden text-gold sm:block"
          >A Field Guide to Professional Life</span
        >
        <span class="eyebrow">Vol. 01</span>
      </div>
      <div class="rule-brass mt-3"></div>
    </div>

    {/* ============================ COVER PLATE / HERO ============================ */}
    <section
      class="mx-auto grid w-full max-w-6xl gap-12 lg:grid-cols-[1fr_minmax(320px,440px)] lg:items-center"
    >
      <div class="space-y-7">
        <div class="fg-rise flex items-center gap-3" style="animation-delay:0.12s">
          <span class="h-px w-10 bg-gold" aria-hidden="true"></span>
          <span class="eyebrow" style="color:hsl(var(--gold))">The 5 Whys Method · Plate 00</span>
        </div>

        <h1
          class="fg-rise text-[2.65rem] leading-none tracking-[-0.02em] text-foreground sm:text-6xl lg:text-[4.1rem]"
          style="animation-delay:0.2s"
        >
          Find the <span class="display-italic text-foam">real reason</span>.<br />
          Then build the <span class="display-italic text-gold">proof</span>.
        </h1>

        <p
          class="fg-rise max-w-xl text-pretty text-lg leading-relaxed text-muted-foreground"
          style="animation-delay:0.28s"
        >
          Six free career tools for students and people changing careers. Work out what you
          want, then turn it into a resume, an application, an introduction and interview answers
          you can stand behind. Everything you write stays on your device.
        </p>

        <div class="fg-rise flex flex-wrap items-center gap-3" style="animation-delay:0.36s">
          <a
            href="#start"
            class="group inline-flex items-center gap-2 rounded-lg bg-primary px-5 py-3 text-sm font-semibold text-primary-foreground transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_18px_40px_-22px_hsl(var(--primary))] focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
          >
            Find where to start
            <svg
              class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
            </svg>
          </a>
          <a
            href="#plates"
            class="inline-flex items-center gap-2 rounded-lg border border-border/60 px-5 py-3 text-sm font-semibold text-foreground transition-colors duration-200 hover:border-gold/50 hover:text-gold"
          >
            See the six tools
          </a>
        </div>

        <div
          class="fg-rise flex flex-wrap gap-x-5 gap-y-2 pt-1"
          style="animation-delay:0.44s"
          aria-label="What this costs you"
        >
          {
            privacyChips.map((chip) => (
              <span class="eyebrow inline-flex items-center gap-2 text-muted-foreground">
                <span class="h-1 w-1 rounded-full bg-gold" aria-hidden="true" />
                {chip}
              </span>
            ))
          }
        </div>
      </div>

      {/* The signature plate: a botanical diagram of a career decision */}
      <figure
        class="fg-rise relative mx-auto w-full max-w-[440px] overflow-hidden rounded-xl border border-border/60 bg-strata bg-card/35"
        style="animation-delay:0.32s"
      >
        {/* corner registration ticks */}
        <span
          class="pointer-events-none absolute left-2.5 top-2.5 h-3 w-3 border-l border-t border-gold/55"
          aria-hidden="true"></span>
        <span
          class="pointer-events-none absolute right-2.5 top-2.5 h-3 w-3 border-r border-t border-gold/55"
          aria-hidden="true"></span>
        <span
          class="pointer-events-none absolute bottom-12 left-2.5 h-3 w-3 border-b border-l border-gold/55"
          aria-hidden="true"></span>
        <span
          class="pointer-events-none absolute bottom-12 right-2.5 h-3 w-3 border-b border-r border-gold/55"
          aria-hidden="true"></span>

        <svg
          viewBox="0 0 480 600"
          class="block w-full"
          style="color:hsl(var(--foreground))"
          role="img"
          aria-label="A diagram of a career decision drawn as a plant. The leaf is the answer you give out loud: I should switch majors. The taproot runs down through three deeper reasons to the root cause at the bottom: help people directly."
        >
          {/* deeper / surface guide ruling */}
          <line
            x1="34"
            y1="182"
            x2="270"
            y2="182"
            stroke="hsl(var(--border))"
            stroke-width="1"
            stroke-dasharray="2 5"></line>
          <text
            x="34"
            y="174"
            font-family="'JetBrains Mono Variable', monospace"
            font-size="10.5"
            letter-spacing="2"
            fill="hsl(var(--muted-foreground))">SURFACE</text
          >

          {/* plant above ground: stem + leaves (the visible answer) */}
          <g class="fg-rise" style="animation-delay:0.5s">
            <path
              d="M160 182 C160 150 160 120 160 96"
              fill="none"
              stroke="hsl(var(--foam))"
              stroke-width="2.4"
              stroke-linecap="round"></path>
            <path
              d="M160 138 C132 132 116 110 118 86 C142 92 160 110 160 138 Z"
              fill="hsl(var(--foam)/0.14)"
              stroke="hsl(var(--foam))"
              stroke-width="1.8"></path>
            <path
              d="M160 120 C188 112 206 90 204 66 C180 74 160 92 160 120 Z"
              fill="hsl(var(--foam)/0.14)"
              stroke="hsl(var(--foam))"
              stroke-width="1.8"></path>
            <path
              d="M160 100 C160 84 168 70 182 60"
              fill="none"
              stroke="hsl(var(--foam))"
              stroke-width="1.8"
              stroke-linecap="round"></path>
          </g>

          {/* rootlets (static) */}
          <g
            stroke="hsl(var(--foam))"
            fill="none"
            stroke-width="1.5"
            stroke-linecap="round"
            opacity="0.85"
          >
            <path d="M159 252 C140 258 126 270 112 290"></path>
            <path d="M161 330 C182 338 198 352 214 372"></path>
            <path d="M159 408 C138 416 124 432 110 456"></path>
            <path d="M161 470 C176 478 188 492 198 512"></path>
          </g>

          {/* the taproot: the signature draw-on-load line, surface foam to brass root */}
          <defs>
            <linearGradient id="taproot" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="hsl(var(--foam))"></stop>
              <stop offset="100%" stop-color="hsl(var(--gold))"></stop>
            </linearGradient>
          </defs>
          <path
            class="fg-root-path"
            pathLength="1"
            d="M160 182 C150 232 174 300 160 360 C150 420 168 486 160 540"
            fill="none"
            stroke="url(#taproot)"
            stroke-width="2.8"
            stroke-linecap="round"></path>

          {/* numbered nodes down the descent */}
          <g font-family="'JetBrains Mono Variable', monospace" font-size="11" font-weight="500">
            {/* 01 · the leaf / answer */}
            <g class="fg-label" style="animation-delay:1.0s">
              <line
                x1="172"
                y1="112"
                x2="300"
                y2="100"
                stroke="hsl(var(--border))"
                stroke-width="1"
                stroke-dasharray="2 4"></line>
              <circle cx="160" cy="120" r="3.5" fill="hsl(var(--foam))"></circle>
              <text x="306" y="96" fill="hsl(var(--muted-foreground))">01 · the answer</text>
              <text
                x="306"
                y="112"
                font-family="'Fraunces Variable', serif"
                font-size="15"
                font-style="italic"
                fill="hsl(var(--foreground))">“I should switch majors.”</text
              >
            </g>
            {/* 02 */}
            <g class="fg-label" style="animation-delay:1.25s">
              <line
                x1="160"
                y1="252"
                x2="300"
                y2="252"
                stroke="hsl(var(--border))"
                stroke-width="1"
                stroke-dasharray="2 4"></line>
              <circle
                cx="160"
                cy="252"
                r="3.5"
                fill="hsl(var(--background))"
                stroke="hsl(var(--foam))"
                stroke-width="1.6"></circle>
              <text x="306" y="249" fill="hsl(var(--muted-foreground))">02</text>
              <text
                x="306"
                y="263"
                font-family="'Fraunces Variable', serif"
                font-size="14"
                fill="hsl(var(--foreground))">the classes feel pointless</text
              >
            </g>
            {/* 03 */}
            <g class="fg-label" style="animation-delay:1.45s">
              <line
                x1="160"
                y1="330"
                x2="300"
                y2="330"
                stroke="hsl(var(--border))"
                stroke-width="1"
                stroke-dasharray="2 4"></line>
              <circle
                cx="160"
                cy="330"
                r="3.5"
                fill="hsl(var(--background))"
                stroke="hsl(var(--foam))"
                stroke-width="1.6"></circle>
              <text x="306" y="327" fill="hsl(var(--muted-foreground))">03</text>
              <text
                x="306"
                y="341"
                font-family="'Fraunces Variable', serif"
                font-size="14"
                fill="hsl(var(--foreground))">I never see who it helps</text
              >
            </g>
            {/* 04 */}
            <g class="fg-label" style="animation-delay:1.65s">
              <line
                x1="160"
                y1="408"
                x2="300"
                y2="408"
                stroke="hsl(var(--border))"
                stroke-width="1"
                stroke-dasharray="2 4"></line>
              <circle
                cx="160"
                cy="408"
                r="3.5"
                fill="hsl(var(--background))"
                stroke="hsl(var(--gold))"
                stroke-width="1.6"></circle>
              <text x="306" y="405" fill="hsl(var(--muted-foreground))">04</text>
              <text
                x="306"
                y="419"
                font-family="'Fraunces Variable', serif"
                font-size="14"
                fill="hsl(var(--foreground))">I like explaining things</text
              >
            </g>
            {/* 05 · the root cause */}
            <g class="fg-root-tip">
              <line
                x1="160"
                y1="540"
                x2="300"
                y2="525"
                stroke="hsl(var(--gold)/0.6)"
                stroke-width="1"></line>
              <circle cx="160" cy="540" r="11" fill="hsl(var(--gold)/0.18)"></circle>
              <circle cx="160" cy="540" r="5.5" fill="hsl(var(--gold))"></circle>
              <text x="306" y="518" fill="hsl(var(--gold))" letter-spacing="1.5"
                >05 · ROOT CAUSE</text
              >
              <text
                x="306"
                y="536"
                font-family="'Fraunces Variable', serif"
                font-size="16"
                font-weight="500"
                fill="hsl(var(--foreground))">help people directly</text
              >
            </g>
          </g>
        </svg>

        <figcaption
          class="flex items-center justify-between border-t border-border/50 px-4 py-2.5"
        >
          <span class="eyebrow">Fig. 1</span>
          <span class="eyebrow text-muted-foreground">Anatomy of a decision</span>
        </figcaption>
      </figure>
    </section>

    {/* ============================ THE WAY IN ============================ */}
    <section
      id="start"
      class="mx-auto w-full max-w-6xl scroll-mt-24"
      aria-labelledby="start-title"
    >
      <div class="rule-brass mb-10"></div>
      <div class="grid gap-x-14 gap-y-8 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="space-y-4">
          <span class="eyebrow" style="color:hsl(var(--gold))">Start from where you are</span>
          <h2 id="start-title" class="text-3xl text-foreground sm:text-[2.4rem] sm:leading-[1.08]">
            What brought you <span class="display-italic text-foam">here</span>?
          </h2>
          <p class="max-w-md text-pretty text-base leading-relaxed text-muted-foreground">
            Pick the line that sounds like you. The tool opens with a guide that walks you through
            it one step at a time, and you can close the guide whenever you like.
          </p>
          <p class="max-w-md text-sm leading-relaxed text-muted-foreground">
            Not sure? <a href="/start/" class="text-foreground underline underline-offset-4"
              >Answer two questions</a
            > and the studio will suggest one.
          </p>
          <p class="max-w-md text-sm leading-relaxed text-muted-foreground">
            Teaching a class? <a
              href="/about/#workshops"
              class="text-foreground underline underline-offset-4">There is a plan for one period</a
            >.
          </p>
        </div>
        <ul class="border-t border-border/40">
          {
            situations.map((s) => (
              <li class="border-b border-border/40">
                <a
                  href={s.href}
                  class="group grid gap-x-6 gap-y-1 py-4 transition-colors hover:bg-overlay/25 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring sm:grid-cols-[minmax(0,1fr)_auto] sm:items-center sm:px-3"
                >
                  <span class="min-w-0 space-y-1">
                    <span class="block font-display text-lg leading-snug text-foreground sm:text-xl">
                      {s.say}
                    </span>
                    <span class="block text-sm leading-relaxed text-muted-foreground">{s.get}</span>
                  </span>
                  <span
                    class="inline-flex items-center gap-1.5 text-sm font-semibold"
                    style={`color: hsl(var(--${s.accent}))`}
                  >
                    {s.tool}
                    <svg
                      class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1 motion-reduce:transition-none"
                      fill="none"
                      viewBox="0 0 24 24"
                      stroke="currentColor"
                      stroke-width="2"
                      aria-hidden="true"
                    >
                      <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                    </svg>
                  </span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ============================ A WORKING SPECIMEN ============================ */}
    <section class="mx-auto w-full max-w-6xl" aria-label="Try it">
      <div class="rule-brass mb-10"></div>
      <HomeSpecimen client:idle />
    </section>

    {/* ============================ THE PLATES ============================ */}
    <section id="plates" class="reveal mx-auto w-full max-w-6xl scroll-mt-24 space-y-10">
      <div class="flex flex-col gap-5 md:flex-row md:items-end md:justify-between">
        <div class="max-w-xl space-y-3">
          <span class="eyebrow" style="color:hsl(var(--gold))">The instruments · Plates I–VI</span>
          <h2 class="text-3xl text-foreground sm:text-[2.6rem] sm:leading-[1.05]">
            Six plates, <span class="display-italic text-foam">one throughline</span
            >.
          </h2>
          <p class="text-pretty text-base text-muted-foreground">
            Each tool works on its own. Run them in order and they cover the whole arc: understand
            the why, prove it, rehearse it, prepare for the interview, apply, and weigh the offer.
          </p>
        </div>
        <div class="eyebrow flex shrink-0 flex-wrap items-center gap-2 text-muted-foreground">
          <span class="text-foam">Reflect</span>
          <span aria-hidden="true">→</span>
          <span class="text-gold">Prove</span>
          <span aria-hidden="true">→</span>
          <span class="text-iris">Rehearse</span>
          <span aria-hidden="true">→</span>
          <span class="text-love">Prepare</span>
          <span aria-hidden="true">→</span>
          <span class="text-lichen">Apply</span>
          <span aria-hidden="true">→</span>
          <span class="text-madder">Weigh</span>
        </div>
      </div>

      <div class="rule-brass"></div>

      <div
        class="reveal-stagger grid gap-px overflow-hidden rounded-xl border border-border/50 bg-border/50 sm:grid-cols-2"
      >
        {
          plates.map((p) => (
            <a
              href={p.href}
              aria-label={`${p.name}. ${p.desc}`}
              class="group relative flex min-w-0 flex-col gap-5 bg-background p-6 transition-colors duration-200 hover:bg-card/55 focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-ring sm:p-8"
              style={`--p: var(--${p.accent})`}
            >
              <span
                class="absolute inset-x-0 top-0 h-0.5 origin-left scale-x-0 bg-p transition-transform duration-300 group-hover:scale-x-100"
                aria-hidden="true"
              />
              <div class="flex items-start justify-between gap-4">
                <div class="space-y-2">
                  <span class="eyebrow" style="color:hsl(var(--p))">
                    {p.tag}
                  </span>
                  <h3 class="text-2xl text-foreground">{p.name}</h3>
                </div>
                <span
                  class="plate-numeral select-none text-[3.4rem] text-p/85 transition-colors duration-200 group-hover:text-p"
                  aria-hidden="true"
                >
                  {p.roman}
                </span>
              </div>

              <p class="text-sm leading-relaxed text-muted-foreground">{p.desc}</p>

              {/* the pinned specimen */}
              <div class="specimen mt-auto p-4">
                <p class="eyebrow mb-3 text-[0.72rem]" style="color:hsl(var(--p))">
                  {p.caption}
                </p>

                {p.roman === 'I' && (
                  <div class="space-y-1.5 font-mono text-xs text-muted-foreground">
                    <p>“more money”</p>
                    <p class="pl-3">↳ “freedom to choose my work”</p>
                    <p class="pl-6 font-semibold text-foam">↳ control over my time</p>
                  </div>
                )}

                {p.roman === 'II' && (
                  <div class="space-y-2 text-xs">
                    <div class="flex items-start gap-2 text-muted-foreground">
                      <span class="num-index shrink-0 text-love">Draft</span>
                      <span>
                        Helped improve the company website.
                      </span>
                    </div>
                    <div class="flex items-start gap-2 text-foreground">
                      <span class="num-index shrink-0 text-gold">Review</span>
                      <span>Name what you changed and the evidence you can support.</span>
                    </div>
                  </div>
                )}

                {p.roman === 'III' && (
                  <div class="space-y-2 text-xs">
                    <p class="font-display text-sm italic leading-snug text-foreground">
                      “I’m Jordan. I’m a second-year in public health, and I’m hoping to meet people
                      who run community programs.”
                    </p>
                    <p class="eyebrow text-[0.72rem] text-muted-foreground">
                      <span class="text-iris">Rehearse, then review</span>
                    </p>
                  </div>
                )}

                {p.roman === 'IV' && (
                  <div class="space-y-1.5 font-mono text-xs text-muted-foreground">
                    <p>
                      <span class="text-love">“cross-functional”</span>
                    </p>
                    <p class="pl-3 text-foreground">
                      ↳ Prepare a story about working across teams
                    </p>
                  </div>
                )}

                {p.roman === 'V' && (
                  <div class="space-y-1.5 text-xs">
                    <p class="text-muted-foreground">
                      <mark class="rounded-[3px] bg-lichen/25 px-0.5 text-foreground"
                        >Experience with Excel, including pivot tables</mark
                      >
                    </p>
                    <p class="pl-3 text-foreground">
                      <span class="num-index mr-1 text-lichen">Required</span> Have it: the survey
                      project
                    </p>
                  </div>
                )}

                {p.roman === 'VI' && (
                  <div class="space-y-1.5 font-mono text-xs text-muted-foreground">
                    <p>$20 an hour, 30 hours, 10 weeks</p>
                    <p class="pl-3 text-foreground">
                      <span class="text-madder">↳</span> $6,000 for the summer
                    </p>
                  </div>
                )}
              </div>

              <span class="inline-flex items-center gap-1.5 text-sm font-semibold text-p">
                Open {p.name}
                <svg
                  class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-1"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  stroke-width="2"
                  aria-hidden="true"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </a>
          ))
        }
      </div>

    </section>

    {/* ============================ FIELD NOTES ============================ */}
    <section class="reveal mx-auto w-full max-w-6xl">
      <div class="grid gap-x-14 gap-y-10 md:grid-cols-[0.85fr_1.15fr]">
        <div class="space-y-4">
          <span class="eyebrow" style="color:hsl(var(--gold))">From the field notes</span>
          <h2 class="text-3xl text-foreground sm:text-[2.4rem] sm:leading-[1.08]">
            Private, and you can <span class="display-italic text-foam">check</span
            >.
          </h2>
          <p class="dropcap max-w-md text-pretty text-base leading-relaxed text-muted-foreground">
            Open one exercise before an application, come back for interview prep, and pick up saved
            work in your <a href="/dashboard/" class="underline underline-offset-4">dashboard</a>.
          </p>
        </div>
        <ul class="self-start bg-ledger">
          {
            fieldNotes.map((row, i) => (
              <li class="flex gap-5 border-t border-border/40 py-5 first:border-t-0 first:pt-0">
                <span
                  class="num-index pt-1 text-sm text-muted-foreground"
                  aria-hidden="true"
                >
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span
                  class="mt-1.5 h-2 w-2 shrink-0 rounded-full"
                  style={`background: hsl(var(--${row.c}))`}
                  aria-hidden="true"
                />
                <div class="space-y-1">
                  <h3 class="text-lg text-foreground">{row.k}</h3>
                  <p class="text-sm leading-relaxed text-muted-foreground">{row.v}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    {/* ============================ COLOPHON / CTA ============================ */}
    <section class="reveal mx-auto w-full max-w-6xl">
      <div class="rule-double"></div>
      <div
        class="flex flex-col items-start gap-7 py-12 text-left sm:items-center sm:py-16 sm:text-center"
      >
        <span class="eyebrow" style="color:hsl(var(--gold))">Begin the guide</span>
        <h2 class="max-w-3xl text-4xl leading-[1.02] text-foreground sm:text-5xl">
          Start where every good decision starts: <span
            class="display-italic text-foam">why</span
          >.
        </h2>
        <a
          href="/career/"
          class="group inline-flex items-center gap-2 rounded-lg bg-primary px-6 py-3.5 text-sm font-semibold text-primary-foreground transition-all duration-200 hover:-translate-y-0.5 hover:shadow-[0_18px_40px_-22px_hsl(var(--primary))] focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 focus-visible:ring-offset-background"
        >
          Ask the first why
          <svg
            class="h-4 w-4 transition-transform duration-200 group-hover:translate-x-0.5"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"></path>
          </svg>
        </a>
      </div>
      <div class="rule-brass"></div>
    </section>

  </div>
</Base>
