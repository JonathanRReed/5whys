---
import ApplicationDesk from '../components/application-desk/ApplicationDesk';
import PlateHeader from '../components/PlateHeader.astro';
import ErrorBoundary from '../components/shared/ErrorBoundary';
import GuideCoach from '../components/shared/GuideCoach';
import Base from '../layouts/Base.astro';

const noScript = [
  "The Application Desk takes one job application from start to finish. You paste the posting once, and the desk sorts out what's required, what's nice to have, and what the day-to-day work looks like, keeping each item linked to the original sentence so you can verify it.",
  "Next you mark where you stand on each requirement (have it, maybe, or not yet) and note how you'll show it or build it. From there you turn one real experience into two bullets for this job, draft a short cover letter in four parts, spin the opener into a LinkedIn message, follow-up email, and call intro, and run a final check before sending.",
  "Without JavaScript you can do the same thing on paper: pull out the top four or five requirements, mark yes, maybe, or no on each one, pick an experience that backs them up, note what happened because of your work, and write two bullets starting with plain action verbs.",
  "Everything you type stays in your browser on this device. Nothing gets sent to a server.",
];
---

<Base
  title="The Application Desk"
  description="Paste a job posting once and work through the whole application: what it asks for, where you stand, two tailored bullets, a cover letter, and a quick check before sending."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'The Application Desk', href: '/application/' },
  ]}
  noScriptContext={noScript}
>
  <div class="relative space-y-10 px-4 pb-16 pt-4 sm:pt-6">
    <PlateHeader
      tag="Plate V · Apply"
      roman="V"
      title="The Application Desk"
      description="Paste a posting once, sort out what it asks for, mark where you stand, write two bullets and a cover letter, and check it before you send."
      accent="lichen"
    />
    <GuideCoach client:load tool="application" />
    {/* Room held for the tool, so the footer does not jump when it loads. */}
    <section class="mx-auto min-h-[70svh] w-full max-w-6xl">
      <ErrorBoundary client:load>
        <ApplicationDesk client:load />
      </ErrorBoundary>
    </section>
  </div>
</Base>
