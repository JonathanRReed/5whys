---
import Base from '../layouts/Base.astro';
import PlateHeader from '../components/PlateHeader.astro';
import NetworkingPracticeApp from '../components/NetworkingPractice';
import ErrorBoundary from '../components/shared/ErrorBoundary';
import GuideCoach from '../components/shared/GuideCoach';

const networkingSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How long should I practice each scenario?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Each scenario sets its own timer, anywhere from thirty seconds to two minutes. Two or three quick rounds is usually plenty to work out the awkward parts.',
        },
      },
      {
        '@type': 'Question',
        name: 'Are the scenarios based on real situations?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. The 12 scenarios cover situations students and career changers run into all the time, like a career fair with a long line behind you, cold emailing a professor about research, an internship fair with a thin resume, or following up after two weeks of silence.',
        },
      },
      {
        '@type': 'Question',
        name: 'What if I have no experience worth mentioning?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Several scenarios include sample lines written for people who don\'t have internships or big numbers yet. Showing up prepared and asking a specific question about the other person\'s work is usually enough.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can I create my own scenarios?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. You can edit any scenario or build your own with custom prompts, audience, and notes.',
        },
      },
    ],
  },
];

const networkingNoScriptContext = [
  "Networking Practice helps you work out a short, natural intro for career fairs, alumni chats, cold outreach, conferences, recruiter calls, and coffee chats. The goal is saying who you are and what you're looking for clearly enough that the other person has something easy to respond to. You don't need to sound like a salesperson.",
  "The interactive tool gives you 12 scenarios, a timer matched to each setting, a draft box for your intro, self-ratings, saved practice history, and exports. Every saved round keeps the exact draft you practiced so you can see how your wording changes. Without JavaScript, you can run the same routine on your own: pick who you're talking to, write a thirty-second intro, say it out loud, note whatever felt clunky, and run it once more.",
  'A solid intro usually covers where you are right now, one concrete thing you\'ve done, and a simple question or ask. For example: "I\'m a second-year biology student, I spent this year running the sign-up schedule for our campus food pantry, and I\'m looking for a summer role doing that kind of organizing for a public health team." Keep it in your own voice so it sounds like you.',
  "Keep the practice log simple: the scenario, the wording you tried, what felt smooth or awkward, and what to follow up on next. Don't put private details about other people in there unless you're fine storing them on your device.",
];
---

<Base
  title="Networking Practice"
  description="Practice your intro against a timer across 12 real networking scenarios, rate each round honestly, and save notes for follow-ups."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Networking Practice', href: '/networking-practice/' },
  ]}
  structuredData={networkingSchemas}
  noScriptContext={networkingNoScriptContext}
>
  <div class="relative overflow-hidden px-4 pb-16 pt-4 sm:pt-6">
    <PlateHeader
      tag="Plate III · Rehearse"
      roman="III"
      title="Networking Practice"
      description="Pick the situation you're walking into, write your intro in your own words, and run it against the timer until it sounds natural."
      accent="iris"
    />
    <GuideCoach client:load tool="networking-practice" />
    <section class="mx-auto w-full max-w-6xl">
      <ErrorBoundary client:load>
        <NetworkingPracticeApp client:load showHeader={false} className="pb-8" />
      </ErrorBoundary>
    </section>

    <section
      class="relative mx-auto mt-12 w-full max-w-6xl reveal"
      aria-labelledby="networking-guide-heading"
    >
      <div class="mb-8 border-t border-border/40 pt-8">
        <span class="eyebrow" style="color: hsl(var(--iris))">How it works</span>
        <h2
          id="networking-guide-heading"
          class="mt-3 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl"
        >
          Practice the opening two minutes
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-3 reveal-stagger">
        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-iris/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-iris/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-iris"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.637-2.346M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.637-2.346m0 0a3.375 3.375 0 116.374-2.346 3.375 3.375 0 01-6.374 2.346z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">Pick a scenario</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            There are 12 scenarios built around real situations: a career fair with a long line
            behind you, emailing a professor cold, an internship fair with a thin resume, or
            walking into a meetup while switching fields. Each comes with sample lines, warm-ups,
            and questions that fit that room.
          </p>
          <div
            class="mt-4 rounded-lg border border-iris/20 bg-iris/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--iris))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              No internships yet? Check the honest sample lines. Showing up prepared and curious
              is enough to start a real conversation.
            </p>
          </div>
        </article>

        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-iris/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-iris/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-iris"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">Draft, then time your rep</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            Write your intro the way you'd actually say it, then run it against the timer. The
            draft box estimates how long it takes to say out loud. Two or three rounds is usually
            enough to smooth out the rough spots without overdoing it.
          </p>
          <div
            class="mt-4 rounded-lg border border-iris/20 bg-iris/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--iris))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              Record yourself on the third try. Hearing it back makes filler words and rushing
              obvious right away.
            </p>
          </div>
        </article>

        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-iris/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-iris/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-iris"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">Review and tweak</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            After each round, rate your confidence, clarity, rapport, and how much it sounded like
            you. Your lowest rating gives you one concrete fix for the next try, and every saved
            round keeps your draft, timing, and notes in your history.
          </p>
          <div
            class="mt-4 rounded-lg border border-iris/20 bg-iris/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--iris))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              Read your latest draft next to one from a few rounds ago so you can see what you
              trimmed out.
            </p>
          </div>
        </article>
      </div>
    </section>
  </div>
</Base>
