---
import Base from '../layouts/Base.astro';
import PlateHeader from '../components/PlateHeader.astro';
import NetworkingPracticeApp from '../components/NetworkingPractice';
import ErrorBoundary from '../components/shared/ErrorBoundary';
import GuideCoach from '../components/shared/GuideCoach';

const networkingSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How long should I practice each scenario?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Each scenario includes a 2-minute timer. Most people find that 2-3 reps per scenario builds confidence without fatigue.',
        },
      },
      {
        '@type': 'Question',
        name: 'Are the scenarios based on real situations?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. The 12 scenarios cover specific situations students and career changers actually face: a career fair with a long line behind you, a cold email to a professor about research, an internship fair with an empty resume, a follow-up after two weeks of silence.',
        },
      },
      {
        '@type': 'Question',
        name: 'What if I have no experience worth mentioning?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Several scenarios include sample lines built for exactly that: no internships, no numbers, no polish. Preparation, curiosity, and specific interest in the other person’s work are honest value. The tool never asks you to borrow someone else’s achievements.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can I create my own scenarios?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. You can customize any scenario or create entirely new versions with your own prompts, audience, and context.',
        },
      },
    ],
  },
];

const networkingNoScriptContext = [
  'Networking Practice Studio is the rehearsal tool in 5 Whys Career Studio. It helps turn vague career background into short, usable conversation reps for career fairs, alumni chats, cold outreach, referrals, conferences, recruiter screens, and informal coffee chats. The aim is a first minute clear enough that the other person understands your direction and can ask a better follow-up question. Sounding polished is beside the point.',
  'The interactive version includes 12 scenarios, a two-minute timer, a draft box for your own intro, self-review ratings, saved practice sessions, and export controls. Every saved session stores the exact draft you practiced, so the history shows how your intro changes between reps. Without JavaScript, you can run the same exercise manually. Pick one audience, write the situation in one sentence, draft a thirty-second introduction, say it out loud, write one thing that felt unclear, and revise the next rep around that weak point. Two or three honest reps are usually more useful than ten vague ones.',
  'A strong networking introduction has a clear role, a current focus, a concrete proof point, and a lightweight ask. For example: “I am a second-year biology student, I spent this year running the sign-up and schedule for our campus food pantry, and I am looking for a summer role where I can do that kind of organizing for a public health team.” The exact words should sound like the person using them, but the structure should make the conversation easier to continue.',
  'The practice log is meant to stay practical. Capture the scenario, the version you tried, the question you received, the detail that landed, and the next follow-up to send. Avoid storing private details about other people unless you are comfortable keeping that note on your own device. The useful output is a repeatable intro, a better question, and a follow-up note that does not sound copied from a template.',
];
---

<Base
  title="Networking Practice"
  description="Rehearse your intro against a two-minute timer across 12 real networking scenarios, rate each rep honestly, and keep the notes that make the follow-up easier."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Networking Practice', href: '/networking-practice/' },
  ]}
  structuredData={networkingSchemas}
  noScriptContext={networkingNoScriptContext}
>
  <div class="relative overflow-hidden px-4 pb-16 pt-4 sm:pt-6">
    <PlateHeader
      tag="Plate III · Rehearse"
      roman="III"
      title="Networking Practice"
      description="Pick the conversation you are walking into, draft the intro in your own words, and run it against the clock until it sounds like you."
      accent="iris"
    />
    <GuideCoach client:load tool="networking-practice" />
    <section class="mx-auto w-full max-w-6xl">
      <ErrorBoundary client:load>
        <NetworkingPracticeApp client:load showHeader={false} className="pb-8" />
      </ErrorBoundary>
    </section>

    <section
      class="relative mx-auto mt-12 w-full max-w-6xl reveal"
      aria-labelledby="networking-guide-heading"
    >
      <div class="mb-8 border-t border-border/40 pt-8">
        <span class="eyebrow" style="color: hsl(var(--iris))">How it works</span>
        <h2
          id="networking-guide-heading"
          class="mt-3 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl"
        >
          Rehearse the first two minutes
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-3 reveal-stagger">
        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-iris/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-iris/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-iris"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M15 19.128a9.38 9.38 0 002.625.372 9.337 9.337 0 004.121-.952 4.125 4.125 0 00-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.637-2.346M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 018.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0111.637-2.346m0 0a3.375 3.375 0 116.374-2.346 3.375 3.375 0 01-6.374 2.346z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">Pick a scenario</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            Twelve scenarios cover situations people actually face: a career fair with a long line
            behind you, a cold email to a professor, an internship fair with an empty resume, an
            industry meetup as a career changer. Each one has an opening blueprint, sample lines,
            warm-ups, and questions tuned to that setting.
          </p>
          <div
            class="mt-4 rounded-lg border border-iris/20 bg-iris/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--iris))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              No experience yet? Look for the honest sample lines. Preparation and curiosity are
              value you already own.
            </p>
          </div>
        </article>

        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-iris/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-iris/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-iris"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M12 6v6h4.5m4.5 0a9 9 0 11-18 0 9 9 0 0118 0z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">Draft, then time your rep</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            Write the intro in your own words, then run it against the two-minute timer. The draft
            box estimates how long your intro takes to say out loud. Two or three reps per scenario
            builds confidence without fatigue.
          </p>
          <div
            class="mt-4 rounded-lg border border-iris/20 bg-iris/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--iris))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              Record yourself on the third rep. You will spot filler words and pacing issues
              instantly.
            </p>
          </div>
        </article>

        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-iris/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-iris/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-iris"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">Review & refine</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            After each rep, rate your confidence, clarity, rapport, and authenticity. The tool turns
            your lowest score into a specific next step, and every saved session keeps your draft,
            your practice time, and your notes so you can watch the intro evolve rep by rep.
          </p>
          <div
            class="mt-4 rounded-lg border border-iris/20 bg-iris/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--iris))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              Compare your newest draft against one from three sessions ago. The difference is the
              progress.
            </p>
          </div>
        </article>
      </div>
    </section>
  </div>
</Base>
