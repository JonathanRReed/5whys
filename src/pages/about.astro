---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { siteConfig } from '../config/site';

const pageUrl = new URL('/about/', siteConfig.siteUrl).toString();
const aboutSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': `${pageUrl}#about`,
    url: pageUrl,
    name: 'About 5 Whys Career Studio',
    description:
      'About 5 Whys Career Studio, a set of practical career reflection and job search tools by Jonathan R. Reed.',
    isPartOf: {
      '@id': 'https://5whys.jonathanrreed.com/#website',
    },
    primaryImageOfPage: new URL(siteConfig.ogImage, siteConfig.siteUrl).toString(),
    author: {
      '@type': 'Person',
      name: siteConfig.author.name,
      url: siteConfig.author.url,
    },
  },
];
---

<Base
  title="About 5 Whys"
  description="About 5 Whys Career Studio, a set of free browser career tools built by Jonathan R. Reed."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'About', href: '/about/' },
  ]}
  structuredData={aboutSchemas}
>
  <div class="relative space-y-10 overflow-hidden px-4 pb-16 pt-8 sm:pt-10">
    <section class="mx-auto w-full max-w-6xl">
      <PageHero
        eyebrow="About"
        title="Career tools you can check for yourself."
        description="Free browser tools for students and anyone switching careers. Figure out what you want, then build a resume, an application, and interview answers you can back up."
      />
    </section>

    <section class="mx-auto w-full max-w-6xl">
      <div class="grid gap-x-14 gap-y-10 border-t border-border/40 pt-10 lg:grid-cols-[0.8fr_1.2fr]">
        <h2 class="text-2xl text-foreground sm:text-3xl">Who it's for</h2>
        <div class="max-w-[68ch] space-y-4 text-base leading-relaxed text-muted-foreground">
          <p>
            Students, people applying for a first job, and people changing careers. By default,
            the examples come from student life like part-time jobs, clubs, and class projects.
            If you tell the career review that you're already working or switching fields, the
            examples switch over to match.
          </p>
          <p>
            These tools are a starting point, and they work best alongside a campus career center,
            a mentor, or a friend who will read your cover letter. They don't replace a real
            person.
          </p>
        </div>

        <h2 class="text-2xl text-foreground sm:text-3xl">How it decides things</h2>
        <div class="max-w-[68ch] space-y-4 text-base leading-relaxed text-muted-foreground">
          <p>
            Every number you see comes from a rule you can inspect yourself. A resume bullet is
            checked for three things: whether it starts with what you did, whether it says what
            happened because of it, and whether it includes a concrete measure. The posting matcher
            points straight at the line on your resume it matched, or tells you it didn't find one.
            There's no hidden score and no claim about how an employer's hiring software will rank
            you, because nobody outside that company can know.
          </p>
          <p>
            By default, rewrite suggestions come from plain rules running right in the page. If
            your browser has a built-in AI model, you can opt in to using it. Anything the model
            invents that you didn't write yourself gets dropped or flagged so fake numbers don't
            sneak onto your resume.
          </p>
          <p>
            The advice follows what most career centers teach. When norms vary by country, like
            resume length, pay conventions, or work authorization, the site notes that it's
            describing the United States.
          </p>
        </div>

        <h2 class="text-2xl text-foreground sm:text-3xl">Who made it</h2>
        <div class="max-w-[68ch] space-y-4 text-base leading-relaxed text-muted-foreground">
          <p>
            I'm <a
              class="font-semibold text-foreground underline underline-offset-4"
              href="https://jonathanrreed.com">Jonathan R. Reed</a
            >, and I built and maintain this site. It's free, <a
              class="font-semibold text-foreground underline underline-offset-4"
              href="https://github.com/JonathanRReed/5whys">open source</a
            >, and has no accounts, ads, or tracking. It stays free because it costs almost
            nothing to host. The pages are static files and everything runs in your own browser, so
            there are no backend servers to pay for and no reason to sell anything. There's no paid
            tier and nothing asks for a credit card. Everything you write stays on your device, and
            the <a
              class="text-foreground underline underline-offset-4"
              href="/privacy/">privacy page</a
            > lays out the exact details.
          </p>
        </div>
      </div>
    </section>

    <section id="workshops" class="mx-auto w-full max-w-6xl scroll-mt-24">
      <div class="grid gap-x-14 gap-y-8 border-t border-border/40 pt-10 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="space-y-3">
          <span class="eyebrow" style="color:hsl(var(--gold))">For advisors and teachers</span>
          <h2 class="text-2xl text-foreground sm:text-3xl">Running a workshop</h2>
          <p class="max-w-md text-base leading-relaxed text-muted-foreground">
            Everything works on shared or lab computers with nothing to install and no logins.
            Three of the tools fit comfortably in one class period, and the rest work well as
            homework.
          </p>
        </div>
        <ol class="max-w-[68ch] border-t border-border/40 text-base leading-relaxed">
          {
            [
              [
                'Open a private window.',
                'On a shared computer, this keeps one student\'s work from showing up for the next person. Have everyone open one before they start.',
              ],
              [
                'Start with the career review.',
                'Two quick questions at /start/ recommend which tool to open first and set the examples to student mode.',
              ],
              [
                'The Five Whys, guided.',
                'Five short answers. Students leave with a clear reason in their own words and one small thing to test it.',
              ],
              [
                'The Resume Game, guided.',
                'Paste three to five lines, or build a first resume from scratch, then rewrite one weak line.',
              ],
              [
                'Networking Practice, guided.',
                'Draft a thirty-second intro and say it out loud to the person next to you.',
              ],
              [
                'Save the work, then wipe the computer.',
                'On the dashboard, export the backup file, email it to yourself, delete it from Downloads, and click Clear everything on this device.',
              ],
            ].map(([step, detail], index) => (
              <li class="flex gap-5 border-b border-border/40 py-4">
                <span class="num-index pt-1 text-sm text-muted-foreground" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="space-y-1">
                  <span class="block font-display text-lg text-foreground">{step}</span>
                  <span class="block text-sm text-muted-foreground">{detail}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </div>
</Base>
