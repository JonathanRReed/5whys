---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { siteConfig } from '../config/site';

const pageUrl = new URL('/about/', siteConfig.siteUrl).toString();
const aboutSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    '@id': `${pageUrl}#about`,
    url: pageUrl,
    name: 'About 5 Whys Career Studio',
    description:
      'About 5 Whys Career Studio, a set of practical career reflection and job search tools by Jonathan R. Reed.',
    isPartOf: {
      '@id': 'https://5whys.jonathanrreed.com/#website',
    },
    primaryImageOfPage: new URL(siteConfig.ogImage, siteConfig.siteUrl).toString(),
    author: {
      '@type': 'Person',
      name: siteConfig.author.name,
      url: siteConfig.author.url,
    },
  },
];
---

<Base
  title="About 5 Whys"
  description="Learn about 5 Whys Career Studio, a practical set of career reflection, resume, networking, and interview preparation tools by Jonathan R. Reed."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'About', href: '/about/' },
  ]}
  structuredData={aboutSchemas}
>
  <div class="relative space-y-10 overflow-hidden px-4 pb-16 pt-8 sm:pt-10">
    <section class="mx-auto w-full max-w-6xl">
      <PageHero
        eyebrow="About"
        title="Career tools you can check."
        description="Free career tools for students and people changing careers. Work out what you want, then turn it into a resume, an application and interview answers you can stand behind."
      />
    </section>

    <section class="mx-auto w-full max-w-6xl">
      <div class="grid gap-x-14 gap-y-10 border-t border-border/40 pt-10 lg:grid-cols-[0.8fr_1.2fr]">
        <h2 class="text-2xl text-foreground sm:text-3xl">Who it is for</h2>
        <div class="max-w-[68ch] space-y-4 text-base leading-relaxed text-muted-foreground">
          <p>
            Students, people looking for a first job, and people changing careers. The examples
            start from a student's life (a part-time job, a club, a class project) and change to
            working-life examples if you say that is where you are.
          </p>
          <p>
            It is a set of tools, not a counselor. It works best beside a campus career center, a
            coach, or a friend who will read your letter. It does not replace any of them.
          </p>
        </div>

        <h2 class="text-2xl text-foreground sm:text-3xl">How it decides things</h2>
        <div class="max-w-[68ch] space-y-4 text-base leading-relaxed text-muted-foreground">
          <p>
            Every number on the site comes from a rule you can read. A resume line is scored for
            three things: whether it starts with what you did, whether it says what happened
            because of it, and whether it gives a measure. The posting match shows the line of
            your resume it found, or says it found none. There is no hidden score and no claim
            about how a hiring system will rank you, because no one outside that system can know.
          </p>
          <p>
            Suggestions are written by rules that run in the page. If your browser has its own
            built-in model you can choose to use it; anything it adds that you did not write is
            thrown away or marked.
          </p>
          <p>
            The advice follows what career centers commonly teach. Where practice differs by
            country (resume length, pay, work authorization), the site says it is describing the
            United States.
          </p>
        </div>

        <h2 class="text-2xl text-foreground sm:text-3xl">Who made it</h2>
        <div class="max-w-[68ch] space-y-4 text-base leading-relaxed text-muted-foreground">
          <p>
            Built and maintained by <a
              class="font-semibold text-foreground underline underline-offset-4"
              href="https://jonathanrreed.com">Jonathan R. Reed</a
            >. It is free, <a
              class="font-semibold text-foreground underline underline-offset-4"
              href="https://github.com/JonathanRReed/5whys">open source</a
            >, and has no accounts, advertising or tracking. It can stay
            free because it costs almost nothing to run: the pages are plain files, and all the
            work happens in your own browser, so there are no servers to pay for and nothing to
            sell. There is no paid version and nothing asks for a card. What you
            write stays on your device; the <a
              class="text-foreground underline underline-offset-4"
              href="/privacy/">privacy page</a
            > says exactly what that means.
          </p>
        </div>
      </div>
    </section>

    <section id="workshops" class="mx-auto w-full max-w-6xl scroll-mt-24">
      <div class="grid gap-x-14 gap-y-8 border-t border-border/40 pt-10 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="space-y-3">
          <span class="eyebrow" style="color:hsl(var(--gold))">For advisors and teachers</span>
          <h2 class="text-2xl text-foreground sm:text-3xl">Running a workshop</h2>
          <p class="max-w-md text-base leading-relaxed text-muted-foreground">
            The tools work on shared and lab computers, with nothing to install and no sign-in.
            Three tools fit in one class period. The others make good homework.
          </p>
        </div>
        <ol class="max-w-[68ch] border-t border-border/40 text-base leading-relaxed">
          {
            [
              [
                'Open a private window.',
                'On a shared computer this keeps one student\'s work away from the next. Ask everyone to do it before they start.',
              ],
              [
                'Start with the career review.',
                'Two questions at /start/ that suggest a tool. It also sets the examples to a student\'s.',
              ],
              [
                'The Five Whys, guided.',
                'Five short answers. Students leave with a reason in their own words and one small step to test it.',
              ],
              [
                'The Resume Game, guided.',
                'Paste three to five lines, or build a first resume from nothing, then rewrite one line.',
              ],
              [
                'Networking Practice, guided.',
                'A thirty-second introduction, said out loud to a neighbor.',
              ],
              [
                'Take the work home, then clear the computer.',
                'On the dashboard: export the work, send the file to yourself, delete it from Downloads, and press Clear everything on this device.',
              ],
            ].map(([step, detail], index) => (
              <li class="flex gap-5 border-b border-border/40 py-4">
                <span class="num-index pt-1 text-sm text-muted-foreground" aria-hidden="true">
                  {String(index + 1).padStart(2, '0')}
                </span>
                <span class="space-y-1">
                  <span class="block font-display text-lg text-foreground">{step}</span>
                  <span class="block text-sm text-muted-foreground">{detail}</span>
                </span>
              </li>
            ))
          }
        </ol>
      </div>
    </section>
  </div>
</Base>
