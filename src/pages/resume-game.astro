---
import Base from '../layouts/Base.astro';
import PlateHeader from '../components/PlateHeader.astro';
import ResumeGameApp from '../components/ResumeGame';
import ErrorBoundary from '../components/shared/ErrorBoundary';
import GuideCoach from '../components/shared/GuideCoach';

const resumeSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'How does the resume scoring work?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The Resume Game scores each bullet out of 100 based on four things it shows you: what you did, what the work was, what happened because of it, and a number or measure if you have one. Then it asks questions to help you fill in whatever is missing.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can I upload my existing resume?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. You can upload .txt, .md, .docx, or .pdf files, or paste your resume text straight into the box.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is my resume data private?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. Everything runs in your browser and nothing gets sent to a server.',
        },
      },
    ],
  },
];

const resumeNoScriptContext = [
  "The Resume Game tackles one common resume problem: bullets that list duties without showing what changed because you did them. The interactive tool scores each line on four visible parts: what you did, what you worked on, what happened afterward, and any real number that gives scale. The goal is making your work easy for a hiring manager to understand quickly.",
  "Without JavaScript, you can check your resume the same way by hand. Go one bullet at a time and ask whether it names the action, what you worked on, who it helped or what constraint you had, and what changed. Weak bullets usually hide behind words like helped, worked on, responsible for, supported, or assisted without explaining what you did.",
  "A plain way to rewrite a line is to underline what you personally handled, start with a clear verb for that action, and add what changed if you know it. If you don't have a real number, skip making one up and say what improved instead, like shorter wait times, fewer mistakes, or a process people kept using.",
  "Because resumes hold employers, personal contact info, and work history, everything stays in your browser during normal use. Look over every rewritten line before you export or send it anywhere so it still sounds like you.",
];
---

<Base
  title="The Resume Game"
  description="Score each resume bullet on what you did and what came of it, then rewrite weak lines in your own words."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'The Resume Game', href: '/resume-game/' },
  ]}
  structuredData={resumeSchemas}
  noScriptContext={resumeNoScriptContext}
>
  <div class="relative space-y-10 overflow-hidden px-4 pb-16 pt-4 sm:pt-6">
    <PlateHeader
      tag="Plate II · Prove"
      roman="II"
      title="The Resume Game"
      description="Score each resume line on what you did and what happened because of it, then rewrite the weak ones and see the score update. Don't have a resume yet? Build your first one from a few short questions."
      accent="gold"
    />
    <GuideCoach client:load tool="resume-game" />
    <section class="mx-auto w-full max-w-6xl">
      <ErrorBoundary client:load>
        <ResumeGameApp
          client:load
          showHeader={false}
          className="px-0 pb-8 pt-0 overflow-hidden"
        />
      </ErrorBoundary>
    </section>

    <section class="mx-auto w-full max-w-6xl" aria-labelledby="ats-heading">
      <div class="grid gap-x-14 gap-y-6 border-t border-border/40 pt-8 lg:grid-cols-[0.8fr_1.2fr]">
        <div class="space-y-3">
          <span class="eyebrow" style="color: hsl(var(--gold))">Common question</span>
          <h2
            id="ats-heading"
            class="text-2xl font-semibold tracking-tight text-foreground sm:text-3xl"
          >
            What an applicant tracking system reads
          </h2>
          <p class="max-w-md text-sm leading-relaxed text-muted-foreground">
            Most companies run applications through software before a person opens them. There's no
            universal ATS score, and no website can tell you how a specific company's setup will
            rank you, but a few basics hold true for almost all of them.
          </p>
        </div>
        <ul class="max-w-[68ch] border-t border-border/40 text-sm leading-relaxed">
          {
            [
              [
                'It reads text in the order your file stores it.',
                'Two-column layouts, tables, and text boxes often scramble when parsed or get skipped. A single column is the safest setup, and you can upload your file above to see how yours reads.',
              ],
              [
                'It looks for normal section headings.',
                'Stick to Education, Experience, Skills, and Projects. Clever headings can confuse the parser.',
              ],
              [
                'It can miss text inside headers and footers.',
                'Put your name, email, and phone number in the main body of the page.',
              ],
              [
                'Recruiters search it using words from the posting.',
                'If the posting uses a phrase that honestly describes your work, use that phrasing. Never stuff in words that aren\'t true.',
              ],
              [
                'Send a Word document or a normal text PDF.',
                'A scanned image or photo of a resume has no readable text for the software to pull.',
              ],
            ].map(([point, detail]) => (
              <li class="border-b border-border/40 py-3">
                <span class="block font-medium text-foreground">{point}</span>
                <span class="block text-muted-foreground">{detail}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section
      class="relative mx-auto w-full max-w-6xl reveal"
      aria-labelledby="resume-guide-heading"
    >
      <div class="mb-8 border-t border-border/40 pt-8">
        <span class="eyebrow" style="color: hsl(var(--gold))">How it works</span>
        <h2
          id="resume-guide-heading"
          class="mt-3 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl"
        >
          Turn vague duties into clear bullets
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-[1.1fr_0.9fr] reveal-stagger">
        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-gold/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-gold/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-gold"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">When to use it</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            Open the Resume Game when a bullet says you were busy without explaining what
            happened. Paste your whole resume or a few lines, then tighten them one at a time
            until a reader can tell what you did. It works whether you're writing a first draft or
            doing a final check before applying.
          </p>
          <div
            class="mt-4 rounded-lg border border-gold/20 bg-gold/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--gold))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              Start with whichever line you're least happy with. Fixing that one usually shows the
              biggest jump.
            </p>
          </div>
        </article>

        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-gold/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-gold/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-gold"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M10.5 6a7.5 7.5 0 107.5 7.5h-7.5V6z"></path>
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M13.5 10.5H21A7.5 7.5 0 0013.5 3v7.5z"></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">What the score means</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            The score only tells you which bullet to fix next. It doesn't predict whether you'll
            get hired. Good bullets usually name what you did, give some sense of scale, show the
            outcome, and skip vague verbs, so a lower score just points at whichever piece is
            missing.
          </p>
          <div
            class="mt-4 rounded-lg border border-gold/20 bg-gold/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--gold))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              A bullet with no numbers can still score well as long as it clearly says what changed
              because of your work.
            </p>
          </div>
        </article>

        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 md:col-span-2 transition-colors duration-200 hover:border-gold/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-gold/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-gold"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931zm0 0L19.5 7.125M18 14v4.75A2.25 2.25 0 0115.75 21H5.25A2.25 2.25 0 013 18.75V8.25A2.25 2.25 0 015.25 6H10"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">How to revise</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            Fix one piece at a time. Start with what you did, explain what the work was,
            add what happened afterward, and only include a number if you have a real one. The
            finished line should still sound like your real work, just easier to read.
          </p>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            If you don't have a number, say what changed instead: what got faster or easier, what
            problem stopped happening, or who ended up using what you built. Plain words read
            better than corporate jargon.
          </p>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            Keep your strongest version and check it against the job posting before you submit.
          </p>
          <div
            class="mt-4 rounded-lg border border-gold/20 bg-gold/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--gold))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              Read the bullet out loud. If it sounds like a generic job description instead of
              something you did, it's probably too vague.
            </p>
          </div>
        </article>
      </div>
    </section>
  </div>
</Base>
