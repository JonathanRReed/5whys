---
import Base from '../../layouts/Base.astro';
import PlateHeader from '../../components/PlateHeader.astro';
import InterviewGlowUpWorkspace from '../../components/interview-glow-up/InterviewGlowUpWorkspace';
import ErrorBoundary from '../../components/shared/ErrorBoundary';
import GuideCoach from '../../components/shared/GuideCoach';
---

<Base
  title="Interview Glow Up · Workspace"
  description="Break down a job posting, write real interview stories, keep them in a library, and build a one-screen cheat sheet for the call."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Interview Glow Up', href: '/interview-glow-up/' },
    { label: 'Workspace', href: '/interview-glow-up/workspace/' },
  ]}
  structuredData={[]}
>
  <div class="relative space-y-10 overflow-hidden px-4 pb-16 pt-4 sm:pt-6">
    <PlateHeader
      tag="Plate IV · Prepare"
      roman="IV"
      title="Interview Workspace"
      description="Paste the job posting, write stories for the skills it asks for, and pull your best ones into a packet for the call."
      accent="love"
    />
    <GuideCoach client:load tool="interview-glow-up" />
    <section class="mx-auto min-h-[70svh] w-full max-w-7xl">
      <ErrorBoundary client:load>
        <InterviewGlowUpWorkspace client:load />
      </ErrorBoundary>
    </section>
    <section class="mx-auto grid w-full max-w-6xl gap-6 md:grid-cols-3">
      <article
        class="rounded-3xl border border-border/35 bg-overlay/25 p-6"
      >
        <h2 class="text-xl font-semibold text-foreground">Decode the job</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          Start with the posting itself: what's required, what's nice to have, the daily duties,
          and the tools it mentions. That keeps your prep tied to the job you're interviewing for.
        </p>
      </article>
      <article
        class="rounded-3xl border border-border/35 bg-overlay/25 p-6"
      >
        <h2 class="text-xl font-semibold text-foreground">Write your stories</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          Add real examples of what you did and what happened afterward. Each story gets tagged
          with the skills it shows so you aren't trying to remember one in the middle of the call.
        </p>
      </article>
      <article
        class="rounded-3xl border border-border/35 bg-overlay/25 p-6"
      >
        <h2 class="text-xl font-semibold text-foreground">Use the packet</h2>
        <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
          Keep the packet short. Pick your strongest stories, leave out the weak ones, and use the
          HUD, a one-screen cheat sheet for the call, as a quick prompt when you need it.
        </p>
      </article>
    </section>
    <section
      class="mx-auto w-full max-w-4xl space-y-4 text-base leading-relaxed text-muted-foreground"
    >
      <h2 class="text-xl font-semibold text-foreground">How to use the packet</h2>
      <p>
        Paste the job posting, see which skills it asks for, attach stories with real outcomes,
        and cut weaker examples out of the packet. By the end you'll have a short list of things
        you can point to.
      </p>
      <p>
        Once you finish your first pass, read through the packet like you're the interviewer. Each
        story should make the setup, your part, and the outcome clear without needing a ton of
        extra backstory. If one still sounds vague, head back to the Library and add a clearer
        result or swap in a better example, then practice saying them out loud in the rehearsal
        room.
      </p>
    </section>
  </div>
</Base>
