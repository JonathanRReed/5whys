---
import PlateHeader from '../../components/PlateHeader.astro';
import RehearsalRoom from '../../components/rehearsal/RehearsalRoom';
import ErrorBoundary from '../../components/shared/ErrorBoundary';
import GuideCoach from '../../components/shared/GuideCoach';
import Base from '../../layouts/Base.astro';

const noScript = [
  'The rehearsal room asks one interview question at a time. You answer out loud or in writing, then review how it went before moving on. Questions come from the job posting you decoded, and each one shows which requirement it came from.',
  'Spoken answers record locally on your device so you can play them back. The page shows basic counts: how long you talked, word count, pace, pauses longer than two seconds, and filler words. Those are just counts, not grades, since there isn\'t one right speed for everyone.',
  'Without JavaScript you can run the same practice with a phone timer: read a question out loud, answer for one to two minutes, and check whether you actually answered what was asked, explained what you personally did, and mentioned what happened because of it.',
  'Recordings stay on your device. Nothing you say or type gets sent to a server.',
];
---

<Base
  title="Interview Glow Up · Rehearsal Room"
  description="Practice interview questions out loud or in writing, one at a time. Play your answer back and check the pacing. Nothing leaves your device."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Interview Glow Up', href: '/interview-glow-up/' },
    { label: 'Rehearsal Room', href: '/interview-glow-up/rehearse/' },
  ]}
  noScriptContext={noScript}
>
  <div class="relative space-y-10 px-4 pb-16 pt-4 sm:pt-6">
    <PlateHeader
      tag="Plate IV · Prepare"
      roman="IV"
      title="The Rehearsal Room"
      description="One question at a time, out loud or in writing. Listen back, see the counts, and try another take if you want."
      accent="love"
    />
    <GuideCoach client:load tool="rehearsal" />
    {/* Room held for the tool, so the footer does not jump when it loads. */}
    <section class="mx-auto min-h-[70svh] w-full max-w-6xl">
      <ErrorBoundary client:load>
        <RehearsalRoom client:load />
      </ErrorBoundary>
    </section>
  </div>
</Base>
