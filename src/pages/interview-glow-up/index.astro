---
import Base from '../../layouts/Base.astro';
import PlateHeader from '../../components/PlateHeader.astro';
import InterviewGlowUpAdvice from '../../components/interview-glow-up/InterviewGlowUpAdvice';
import { siteConfig } from '../../config/site';
import { ogImageFor } from '../../config/og';

const pageUrl = new URL('/interview-glow-up/', siteConfig.siteUrl).toString();
const glowUpSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    '@id': `${pageUrl}#howto`,
    url: pageUrl,
    name: 'Interview Glow Up: prepare for an interview with stories you can prove',
    description:
      'Decode a job posting, write a true story for each skill it tests, and build a one-screen cheat sheet you can read before the call.',
    inLanguage: 'en-US',
    author: {
      '@type': 'Person',
      name: siteConfig.author.name,
      url: siteConfig.author.url,
    },
    image: new URL(ogImageFor('/interview-glow-up/'), siteConfig.siteUrl).toString(),
    step: [
      {
        '@type': 'HowToStep',
        name: 'Understand interview anxiety',
        text: 'Nerves are normal. Treating an interview like an exam puts you in fight, flight, or freeze mode, and naming that is what lets you prepare around it.',
      },
      {
        '@type': 'HowToStep',
        name: 'Write stories with proof',
        text: 'Prepare short, true stories: the Play is what you did, the Proof is what came of it. A story with proof holds up when the interviewer asks a follow-up question.',
      },
      {
        '@type': 'HowToStep',
        name: 'Decode the job posting',
        text: 'Sort the job posting into what is required, what is nice to have, and the duties, see which skills each line tests, then match each one against your own experience.',
      },
      {
        '@type': 'HowToStep',
        name: 'Build your interview packet',
        text: 'Pull your stories, three keywords, and a fallback story onto one screen, a cheat sheet you can read before or during the interview.',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is the Play + Proof method?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Every interview story carries two parts: the Play is what you did, and the Proof is what came of it. You build a small library of those and pull out the one the question calls for.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do I decode a job posting?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Paste the job posting into the decoder. It sorts each line into required, nice to have, or a duty, and tags the skill each one tests. Then match them against your own experience to see your gaps and strengths.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is my interview data private?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. Job postings, stories, and packets are stored in your browser. Nothing is sent to any server.',
        },
      },
    ],
  },
];
---

<Base
  title="Interview Glow Up"
  description="Decode a job posting into the skills it tests, write interview stories you can prove, and build a one-screen cheat sheet to read before the call."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Interview Glow Up', href: '/interview-glow-up/' },
  ]}
  structuredData={glowUpSchemas}
>
  <div class="relative overflow-hidden px-4 pb-16 pt-4 sm:pt-6">
    <PlateHeader
      tag="Plate IV · Prepare"
      roman="IV"
      title="Interview Glow Up"
      description="Decode a job posting into the skills it actually tests, then build proof-based stories for each one."
      accent="love"
    />
    <section class="mx-auto w-full max-w-6xl">
      {/* Static prose: no directive, so Astro renders it at build time and the
          page ships no JavaScript for it. */}
      <InterviewGlowUpAdvice />
    </section>

    {/* Quick Stats */}
    <section
      class="mx-auto mt-10 grid w-full max-w-6xl grid-cols-2 gap-3 sm:grid-cols-4 reveal"
      aria-label="Interview glow up quick stats"
    >
      <div
        class="flex items-center gap-3 rounded-xl border border-border/50 bg-card/50 px-4 py-3"
      >
        <div
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-love/15"
        >
          <svg
            aria-hidden="true"
            class="h-4 w-4 text-love"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"></path>
          </svg>
        </div>
        <div>
          <p class="text-xs font-semibold text-foreground">Posting decoder</p>
          <p class="text-[0.72rem] text-muted-foreground">What the job tests</p>
        </div>
      </div>
      <div
        class="flex items-center gap-3 rounded-xl border border-border/50 bg-card/50 px-4 py-3"
      >
        <div
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-love/15"
        >
          <svg
            aria-hidden="true"
            class="h-4 w-4 text-love"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"
            ></path>
          </svg>
        </div>
        <div>
          <p class="text-xs font-semibold text-foreground">Story builder</p>
          <p class="text-[0.72rem] text-muted-foreground">What you did, what came of it</p>
        </div>
      </div>
      <div
        class="flex items-center gap-3 rounded-xl border border-border/50 bg-card/50 px-4 py-3"
      >
        <div
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-love/15"
        >
          <svg
            aria-hidden="true"
            class="h-4 w-4 text-love"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"
            ></path>
          </svg>
        </div>
        <div>
          <p class="text-xs font-semibold text-foreground">Interview packet</p>
          <p class="text-[0.72rem] text-muted-foreground">One screen</p>
        </div>
      </div>
      <div
        class="flex items-center gap-3 rounded-xl border border-border/50 bg-card/50 px-4 py-3"
      >
        <div
          class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-love/15"
        >
          <svg
            aria-hidden="true"
            class="h-4 w-4 text-love"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9 12.75L11.25 15 15 9.75m-3-7.036A11.959 11.959 0 013.598 6 11.99 11.99 0 003 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285z"
            ></path>
          </svg>
        </div>
        <div>
          <p class="text-xs font-semibold text-foreground">The HUD</p>
          <p class="text-[0.72rem] text-muted-foreground">A one-screen cheat sheet for the call</p>
        </div>
      </div>
    </section>

    <section
      class="relative mx-auto mt-12 w-full max-w-6xl reveal"
      aria-labelledby="interview-guide-heading"
    >
      <div class="mb-8 border-t border-border/40 pt-8">
        <span class="eyebrow" style="color: hsl(var(--love))">How it works</span>
        <h2
          id="interview-guide-heading"
          class="mt-3 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl"
        >
          Prep around what you can prove
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-3 reveal-stagger">
        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-love/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-love/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-love"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">Decode the job posting</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            Paste a job posting. Each line is sorted into what is required, what is nice to have,
            and the duties, and tagged with the skill it tests. Then you can see which skills you
            already have a story for, and which you do not.
          </p>
          <div
            class="mt-4 rounded-lg border border-love/20 bg-love/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--love))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              Watch the repeated phrases: the decoder counts them for you. If "schedule" keeps coming
              back, have a story about a schedule you kept together.
            </p>
          </div>
        </article>

        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-love/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-love/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-love"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">Write stories with proof</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            For each skill, write a short true story in four parts: a Trigger (a short name that
            brings it back to mind), a Hook (the situation), the Play (what you did), and the Proof
            (what came of it). A story with proof holds up under a follow-up question; a memorized
            answer usually does not.
          </p>
          <div
            class="mt-4 rounded-lg border border-love/20 bg-love/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--love))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              Write the Proof first. If it is weak, the story needs a different example.
            </p>
          </div>
        </article>

        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-love/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-love/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-love"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">Assemble your packet</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            Pull your best stories into one packet for the job. The HUD, a one-screen cheat sheet
            for the call, keeps it short enough to read on your way in.
          </p>
          <div
            class="mt-4 rounded-lg border border-love/20 bg-love/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--love))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              Print or screenshot your packet. Having a physical backup reduces last-minute anxiety.
            </p>
          </div>
        </article>
      </div>
    </section>
  </div>
</Base>
