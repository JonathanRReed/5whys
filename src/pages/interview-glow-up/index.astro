---
import Base from '../../layouts/Base.astro';
import PlateHeader from '../../components/PlateHeader.astro';
import InterviewGlowUpAdvice from '../../components/interview-glow-up/InterviewGlowUpAdvice';
import { siteConfig } from '../../config/site';
import { ogImageFor } from '../../config/og';

const pageUrl = new URL('/interview-glow-up/', siteConfig.siteUrl).toString();
const glowUpSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'HowTo',
    '@id': `${pageUrl}#howto`,
    url: pageUrl,
    name: 'Interview Glow Up: prepare for an interview with stories you can prove',
    description:
      'Decode a job posting, write a true story for each skill it tests, and build a one-screen cheat sheet you can read before the call.',
    inLanguage: 'en-US',
    author: {
      '@type': 'Person',
      name: siteConfig.author.name,
      url: siteConfig.author.url,
    },
    image: new URL(ogImageFor('/interview-glow-up/'), siteConfig.siteUrl).toString(),
    step: [
      {
        '@type': 'HowToStep',
        name: 'Drop the test framing',
        text: 'Nerves are normal. Treating an interview like an oral exam makes people lock up, and preparing real examples ahead of time lowers the pressure.',
      },
      {
        '@type': 'HowToStep',
        name: 'Write stories you can back up',
        text: 'Prepare short, true stories where the Play is what you did and the Proof is what happened afterward. Real examples hold up much better when an interviewer asks follow-up questions.',
      },
      {
        '@type': 'HowToStep',
        name: 'Break down the job posting',
        text: 'Sort the posting into required skills, nice to haves, and day-to-day duties, see which skills each line asks for, and compare them with your own experience.',
      },
      {
        '@type': 'HowToStep',
        name: 'Build your interview packet',
        text: 'Pull your best stories, three key words, and a backup story onto a one-screen cheat sheet for the call.',
      },
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is the Play + Proof method?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Each interview story centers on two parts: the Play is what you actually did, and the Proof is what happened because of it. You keep a small set of those ready and pull up whichever one fits the question.',
        },
      },
      {
        '@type': 'Question',
        name: 'How do I decode a job posting?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Paste the job posting into the decoder. It sorts each line into required, nice to have, or a duty, and tags the skill behind it so you can see where you already have a good story and where you still need one.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is my interview data private?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. Job postings, stories, and packets stay in your browser on your device. Nothing gets sent to a server.',
        },
      },
    ],
  },
];
---

<Base
  title="Interview Glow Up"
  description="Break down a job posting into the skills it tests, write real interview stories you can back up, and put together a one-screen cheat sheet for the call."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Interview Glow Up', href: '/interview-glow-up/' },
  ]}
  structuredData={glowUpSchemas}
>
  <div class="relative overflow-hidden px-4 pb-16 pt-4 sm:pt-6">
    <PlateHeader
      tag="Plate IV · Prepare"
      roman="IV"
      title="Interview Glow Up"
      description="Break down a job posting into the skills it tests, then write real stories from your own work for each one."
      accent="love"
    />
    <section class="mx-auto w-full max-w-6xl">
      {/* Static prose: no directive, so Astro renders it at build time and the
          page ships no JavaScript for it. */}
      <InterviewGlowUpAdvice />
    </section>

    <section
      class="relative mx-auto mt-12 w-full max-w-6xl reveal"
      aria-labelledby="interview-guide-heading"
    >
      <div class="mb-8 border-t border-border/40 pt-8">
        <span class="eyebrow" style="color: hsl(var(--love))">How it works</span>
        <h2
          id="interview-guide-heading"
          class="mt-3 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl"
        >
          Prep around real examples
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-3 reveal-stagger">
        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-love/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-love/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-love"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">Decode the job posting</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            Paste a job posting and the tool sorts each line into required, nice to have, or
            duties, then tags the skill behind it. That makes it easy to see which skills you
            already have a story for and which ones you don't.
          </p>
          <div
            class="mt-4 rounded-lg border border-love/20 bg-love/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--love))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              Pay attention to phrases that show up more than once. If "schedule" keeps popping up,
              bring a story about a schedule you actually managed.
            </p>
          </div>
        </article>

        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-love/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-love/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-love"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">Write stories you can back up</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            For each skill, write a short true story in four parts: a Trigger to jog your memory,
            a Hook for the setup, the Play for what you did, and the Proof for what happened
            afterward. Real stories hold up when interviewers ask follow-ups, while memorized scripts
            fall apart fast.
          </p>
          <div
            class="mt-4 rounded-lg border border-love/20 bg-love/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--love))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              Write the Proof part first. If nothing changed, pick a different example.
            </p>
          </div>
        </article>

        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-love/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-love/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-love"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9 12h3.75M9 15h3.75M9 18h3.75m3 .75H18a2.25 2.25 0 002.25-2.25V6.108c0-1.135-.845-2.098-1.976-2.192a48.424 48.424 0 00-1.123-.08m-5.801 0c-.065.21-.1.433-.1.664 0 .414.336.75.75.75h4.5a.75.75 0 00.75-.75 2.25 2.25 0 00-.1-.664m-5.8 0A2.251 2.251 0 0113.5 2.25H15c1.012 0 1.867.668 2.15 1.586m-5.8 0c-.376.023-.75.05-1.124.08C9.095 4.01 8.25 4.973 8.25 6.108V8.25m0 0H4.875c-.621 0-1.125.504-1.125 1.125v11.25c0 .621.504 1.125 1.125 1.125h9.75c.621 0 1.125-.504 1.125-1.125V9.375c0-.621-.504-1.125-1.125-1.125H8.25zM6.75 12h.008v.008H6.75V12zm0 3h.008v.008H6.75V15zm0 3h.008v.008H6.75V18z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">Put together your packet</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            Pull your best stories into one packet for that specific job. The HUD gives you a
            one-screen cheat sheet for the call so you can glance at your prompts without digging
            through notes.
          </p>
          <div
            class="mt-4 rounded-lg border border-love/20 bg-love/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--love))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              Print the packet or save a screenshot before the call so you aren't fumbling with
              browser windows if your screen freezes.
            </p>
          </div>
        </article>
      </div>
    </section>
  </div>
</Base>
