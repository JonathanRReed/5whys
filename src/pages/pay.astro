---
import PayTool from '../components/pay/PayTool';
import PlateHeader from '../components/PlateHeader.astro';
import ErrorBoundary from '../components/shared/ErrorBoundary';
import GuideCoach from '../components/shared/GuideCoach';
import { hasWages } from '../config/pay';
import Base from '../layouts/Base.astro';

const noScript = [
  ...(hasWages ? ["Pay shows what an occupation usually pays in the United States using public wage data from the Bureau of Labor Statistics. Numbers show up as percentiles: 10th, 25th, 50th (the median), 75th, and 90th. Those cover everyone in the job across every experience level. The survey doesn't track starting pay separately, so a lower percentile isn't automatically an entry-level wage."] : []),
  "The offer worksheet converts an offer or posted rate into one set of numbers: hourly, monthly, and yearly. Guaranteed bonuses stay separate from pay that isn't promised, and a one-time bonus only counts in the first year. It never guesses a 40-hour week or 52-week year for you; if hours or weeks are empty, anything depending on them stays blank.",
  ...(hasWages ? ["Job titles match against the O*NET list right on your device, so nothing you type gets sent anywhere."] : []),
];
---

<Base
  title="Pay"
  description={hasWages
    ? 'Look up what a job usually pays using dated public wage data, and convert an offer into hourly and yearly numbers you can compare.'
    : 'Convert an offer into hourly and yearly numbers you can compare, with overtime and bonuses counted.'}
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Pay', href: '/pay/' },
  ]}
  noScriptContext={noScript}
>
  <div class="relative space-y-10 px-4 pb-16 pt-4 sm:pt-6">
    <PlateHeader
      tag="Plate VI · Weigh"
      roman="VI"
      title="Pay"
      description={hasWages
        ? 'Look up what a job usually pays with the source and year right next to every figure, and convert an offer into numbers you can compare.'
        : 'Convert an offer into hourly, weekly, monthly, and yearly numbers you can compare.'}
      accent="madder"
    />
    <GuideCoach client:load tool="pay" />
    <section class="mx-auto w-full max-w-6xl">
      <ErrorBoundary client:load>
        <PayTool client:load />
      </ErrorBoundary>
    </section>
  </div>
</Base>
