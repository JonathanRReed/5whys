---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { siteConfig } from '../config/site';

const pageUrl = new URL('/subprocessors/', siteConfig.siteUrl).toString();
const subprocessorSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    '@id': `${pageUrl}#subprocessors`,
    url: pageUrl,
    name: '5 Whys Career Studio Subprocessors',
    description:
      'Subprocessor and hosting disclosure for 5 Whys Career Studio. One provider, Cloudflare, serves the pages. The site loads no analytics script.',
    isPartOf: {
      '@id': 'https://5whys.jonathanrreed.com/#website',
    },
    author: {
      '@type': 'Person',
      name: siteConfig.author.name,
      url: siteConfig.author.url,
    },
  },
];

const processors = [
  {
    name: 'Cloudflare',
    role: 'Static hosting, DNS, security headers, and CDN delivery.',
    data: 'Request metadata such as IP address, user agent, URL, and timestamp, needed to serve and protect the site. Cloudflare keeps counts of requests as part of hosting.',
    location: 'United States and global Cloudflare network locations.',
  },
];
---

<Base
  title="Subprocessors"
  description="Hosting and infrastructure disclosure for 5 Whys Career Studio. Cloudflare serves the static files and the site loads no analytics."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Privacy', href: '/privacy/' },
    { label: 'Subprocessors', href: '/subprocessors/' },
  ]}
  structuredData={subprocessorSchemas}
>
  <div class="relative space-y-10 overflow-hidden px-4 pb-16 pt-8 sm:pt-10">
    <section class="mx-auto w-full max-w-6xl">
      <PageHero
        eyebrow="Subprocessors"
        title="One hosting provider."
        description="5 Whys Career Studio is a static site. The tools run in your browser, so Cloudflare is the only outside service involved."
      />
    </section>

    <section class="mx-auto w-full max-w-4xl space-y-6">
      {
        processors.map((processor) => (
          <article class="rounded-xl border border-border/50 bg-card/50 p-6">
            <div class="flex flex-wrap items-start justify-between gap-3">
              <div>
                <p class="eyebrow eyebrow-accent">Infrastructure provider</p>
                <h2 class="mt-2 text-xl font-semibold text-foreground">{processor.name}</h2>
              </div>
              <span class="rounded-full border border-border/60 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-muted-foreground">
                Active
              </span>
            </div>
            <dl class="mt-5 grid gap-4 text-sm leading-relaxed text-muted-foreground">
              <div>
                <dt class="font-semibold text-foreground">Purpose</dt>
                <dd class="mt-1">{processor.role}</dd>
              </div>
              <div>
                <dt class="font-semibold text-foreground">Data involved</dt>
                <dd class="mt-1">{processor.data}</dd>
              </div>
              <div>
                <dt class="font-semibold text-foreground">Location</dt>
                <dd class="mt-1">{processor.location}</dd>
              </div>
            </dl>
          </article>
        ))
      }
    </section>

    <section class="mx-auto w-full max-w-4xl">
      <p class="eyebrow eyebrow-accent mb-5 border-t border-border/40 pt-10">
        Scope
      </p>
      <div class="space-y-4 text-base leading-relaxed text-muted-foreground">
        <p>
          Everything you type into the tools, like career drafts, resume bullets, interview notes,
          and networking scripts, stays inside your browser during normal use. There's no account
          system, no payment processor, and no server-side database storing your documents.
        </p>
        <p>
          Cloudflare sees standard request metadata so it can deliver the pages, block abuse, and
          apply security headers. The site doesn't load any analytics scripts, and its content
          security policy only lets pages talk to this site's own address. If a request to the site
          fails, your browser may send Cloudflare a short network error report with the URL, time,
          and error type. That's part of Cloudflare's network error logging and never includes
          anything you wrote in a tool.
        </p>
        <p>
          If you email me directly outside the site, that message travels through your normal email
          provider like any other email and isn't connected to the static site.
        </p>
        <p>
          If I ever change hosts or add another provider, I'll update this page before sending live
          traffic there.
        </p>
      </div>
    </section>
  </div>
</Base>
