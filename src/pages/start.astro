---
import PlateHeader from '../components/PlateHeader.astro';
import Base from '../layouts/Base.astro';
import OnboardingWizard from '../components/OnboardingWizard';

const noScriptContext = [
  'The career review on this page is a short two-question wizard that requires JavaScript. It asks where you are in your career, from student through senior and transitioning, and what you are working on right now: direction, resume, interviews, or networking. It then recommends one of the four studio tools and a concrete first step. Your answers stay in this browser.',
  'Without JavaScript you can still go straight to any tool: the five whys reflection for direction, the resume game for bullet scoring, networking practice for timed reps, or the interview workspace for proof-based stories.',
];
---

<Base
  title="Career Review · 5 Whys Career Studio"
  description="Take a quick career review to choose the right 5 Whys tool for your current goal, from reflection to resume polish, networking practice, or interview prep."
  noScriptContext={noScriptContext}
>
  <div class="relative mx-auto w-full max-w-6xl px-4 pb-16 pt-4 sm:pt-6">
    <PlateHeader
      tag="The studio · Start here"
      roman=""
      title="Career review"
      description="Two questions about where you are and what is in the way, then one tool to begin with. Your answers stay in this browser."
      accent="gold"
    />
    <OnboardingWizard client:load />
  </div>
</Base>
