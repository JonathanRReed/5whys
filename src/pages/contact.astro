---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { siteConfig } from '../config/site';

const pageUrl = new URL('/contact/', siteConfig.siteUrl).toString();
const contactSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    '@id': `${pageUrl}#contact`,
    url: pageUrl,
    name: 'Contact 5 Whys Career Studio',
    description: 'Contact page for 5 Whys Career Studio, including support and project inquiries.',
    isPartOf: {
      '@id': 'https://5whys.jonathanrreed.com/#website',
    },
    author: {
      '@type': 'Person',
      name: siteConfig.author.name,
      url: siteConfig.author.url,
    },
  },
];
---

<Base
  title="Contact"
  description="Get in touch with Jonathan R. Reed about 5 Whys Career Studio for bug reports, tool feedback, privacy questions, or consulting."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Contact', href: '/contact/' },
  ]}
  structuredData={contactSchemas}
>
  <div class="relative space-y-10 overflow-hidden px-4 pb-16 pt-8 sm:pt-10">
    <section class="mx-auto w-full max-w-6xl">
      <PageHero
        eyebrow="Contact"
        title="Send feedback or report a bug."
        description="Reach out if something broke, a prompt felt confusing, you have a privacy question, or you want to talk about a project."
      />
    </section>

    <section class="mx-auto grid w-full max-w-4xl gap-5 md:grid-cols-[1fr_0.8fr] reveal">
      <article
        class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-foam/40 hover:bg-card/70"
      >
        <div
          class="mb-3 flex h-8 w-8 items-center justify-center rounded-lg bg-foam/12 eyebrow-accent"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"
            ></path></svg
          >
        </div>
        <h2 class="text-lg font-semibold text-foreground">Email</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          For feedback, bug reports, privacy requests, or anything else, send a note to
          <a
            class="font-semibold text-foreground [overflow-wrap:anywhere] hover:text-accent focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring"
            href="mailto:contact@JonathanRReed.com">contact@JonathanRReed.com</a
          >.
        </p>
      </article>
      <article
        class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-foam/40 hover:bg-card/70"
      >
        <div
          class="mb-3 flex h-8 w-8 items-center justify-center rounded-lg bg-iris/12 text-iris"
        >
          <svg
            class="h-4 w-4"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
            ><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M20.25 14.15v4.25c0 1.094-.787 2.036-1.872 2.18-2.087.277-4.216.42-6.378.42s-4.291-.143-6.378-.42c-1.085-.144-1.872-1.086-1.872-2.18v-4.25m16.5 0a2.18 2.18 0 00.75-1.661V8.706c0-1.081-.768-2.015-1.872-2.18a49.11 49.11 0 00-6.378-.42c-2.115 0-4.198.143-6.378.42-1.085.165-1.872 1.099-1.872 2.18v3.773c0 .65.27 1.24.75 1.661"
            ></path><path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 15.75V12m0 0V8.25m0 3.75h3.75m-3.75 0H8.25"></path></svg
          >
        </div>
        <h2 class="text-lg font-semibold text-foreground">Portfolio</h2>
        <p class="mt-2 text-sm leading-relaxed text-muted-foreground">
          You can see my other projects at
          <a
            class="font-semibold text-foreground [overflow-wrap:anywhere] hover:text-accent focus-visible:outline-hidden focus-visible:ring-2 focus-visible:ring-ring"
            href="https://jonathanrreed.com/projects/">jonathanrreed.com</a
          >.
        </p>
      </article>
    </section>

    <section class="mx-auto w-full max-w-4xl reveal">
      <p class="eyebrow eyebrow-accent mb-5 border-t border-border/40 pt-10">
        What helps in a note
      </p>
      <div class="space-y-4 text-base leading-relaxed text-muted-foreground">
        <p>
          If something broke, let me know which page you were on, what browser and device you were
          using, and what you expected to happen. If a prompt or piece of wording felt confusing,
          just paste the line that tripped you up and tell me what kind of job or situation you
          were working on.
        </p>
        <p>
          If you're reaching out about consulting or a project, tell me what you're trying to build
          or fix and what kind of help you need. You can use the same email for accessibility bugs
          and privacy requests.
        </p>
        <p>
          Please don't attach confidential employer files or private personal records when
          reporting a bug. The page name, the step that broke, and a short fake example are usually
          plenty for me to reproduce it and ship a fix.
        </p>
        <p>
          For accessibility issues, include the screen reader, keyboard steps, or screen size you
          were using so I can test the same setup.
        </p>
      </div>
    </section>
  </div>
</Base>
