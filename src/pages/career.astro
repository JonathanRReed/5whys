---
import Base from '../layouts/Base.astro';
import PlateHeader from '../components/PlateHeader.astro';
import Career5Whys from '../components/Career5Whys';
import ErrorBoundary from '../components/shared/ErrorBoundary';
import GuideCoach from '../components/shared/GuideCoach';
import { siteConfig } from '../config/site';
import { ogImageFor } from '../config/og';

const pageUrl = new URL('/career/', siteConfig.siteUrl).toString();
const careerSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    '@id': `${pageUrl}#creativework`,
    url: pageUrl,
    name: 'Career Reflection · Five Whys',
    description:
      'Guided five whys exercise that chains each answer into the next question, tracing a career decision from surface reason to root reason.',
    inLanguage: 'en-US',
    author: {
      '@type': 'Person',
      name: siteConfig.author.name,
      url: siteConfig.author.url,
    },
    image: new URL(ogImageFor('/career/'), siteConfig.siteUrl).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is the five whys exercise?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The five whys is a root-cause technique where you ask "why" five times in succession, each question building on your previous answer, to trace a career decision from its surface reason to its root reason.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is my data stored securely?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'All data is stored locally in your browser. Nothing is sent to any server.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can I export my reflection?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. You can export your complete reflection as a JSON file at any time.',
        },
      },
    ],
  },
];

const careerNoScriptContext = [
  'Career Reflection is the five-layer decision tool inside 5 Whys Career Studio. It is meant for moments when a career question is too vague to act on, such as whether to change teams, apply for a role, leave a project, pursue a different specialty, or explain what kind of work actually fits. The exercise asks for the visible reason first, then keeps pressing for the deeper constraint, value, tradeoff, and evidence behind that reason.',
  'The interactive version gives you guided prompts, local saving, summary generation, and export controls. Without JavaScript, the same workflow can be followed manually: write the surface problem, ask why that answer is true, repeat that question four more times, then rewrite the final answer as a testable career signal. A useful final signal names what matters, what constraint is real, what evidence supports it, and what next step would reduce uncertainty.',
  'Good answers tend to be specific rather than dramatic. Instead of stopping at “I want a better job,” the reflection should move toward statements like “I want work where I explain things to people one at a time, the way I do when I tutor,” or “I am avoiding this major because the classes I like in it are the writing ones, not the lab ones.” What you want at the end is a clearer reason, specific enough to guide a resume, networking pitch, interview story, or next experiment.',
  'A useful way to review the final answer is to ask whether it changes a decision. If the answer only restates frustration, keep going. If it helps you choose which job description to ignore, which project to highlight, which person to ask for advice, or which constraint to negotiate, it is probably specific enough. The best reflection output is small but actionable: one sentence of direction, one sentence of evidence, and one next move that can be tested this week.',
  'Privacy matters because career reflection can include names, employers, worries, and sensitive drafts. The public tool is designed for browser-local work. Treat the export as your own career note, review it before sharing, and remove private details about other people or organizations. If the reflection starts producing interview material, carry the strongest proof into the resume game or interview workspace instead of keeping it as a vague journal entry.',
];
---

<Base
  title="The Five Whys"
  description="Work through five guided layers of why to uncover the values, constraints, and impact signals that should guide your next career move."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Career Reflection', href: '/career/' },
  ]}
  structuredData={careerSchemas}
  noScriptContext={careerNoScriptContext}
>
  <div class="relative overflow-hidden px-4 pb-16 pt-4 sm:pt-6">
    <PlateHeader
      tag="Plate I · Reflect"
      roman="I"
      title="The Five Whys"
      description="Ask why five times until the answer stops moving. You leave with the reason underneath the obvious one, in your own words, and one step that tests it."
      accent="foam"
    />
    <GuideCoach client:load tool="career" />
    <section id="why-flow" class="mx-auto w-full max-w-6xl">
      <ErrorBoundary client:load>
        <Career5Whys client:load showHeader={false} showFooter={false} className="pb-8" />
      </ErrorBoundary>
    </section>

    <section
      class="relative mx-auto mt-12 w-full max-w-6xl reveal"
      aria-labelledby="career-guide-heading"
    >
      <div class="mb-8 border-t border-border/40 pt-8">
        <span class="eyebrow" style="color: hsl(var(--foam))">How it works</span>
        <h2
          id="career-guide-heading"
          class="mt-3 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl"
        >
          Get clarity in five layers
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-3 reveal-stagger">
        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-foam/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-foam/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-foam"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">Name the real reason</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            The five whys format is useful when a career answer sounds true but still feels too
            broad. Keep asking why until the reason names a value, constraint, skill, environment,
            or tradeoff you can act on.
          </p>
          <div
            class="mt-4 rounded-lg border border-foam/20 bg-foam/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--foam))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              If your answer is "more money," ask what the money enables. That deeper reason usually
              reveals the real criteria.
            </p>
          </div>
        </article>

        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-foam/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-foam/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-foam"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8.242 5.992h12m-12 6h12m-12 6h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">Turn notes into criteria</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            When the chain is complete, press the phrases that sound most like you to build your
            statement. Then write two short lists: what a role must offer, and what you can give up.
            Those lists are what you leave with.
          </p>
          <div
            class="mt-4 rounded-lg border border-foam/20 bg-foam/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--foam))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              Copy the lists and keep them beside every posting or offer you read.
            </p>
          </div>
        </article>

        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-foam/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-foam/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-foam"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">Reuse the outcome</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            Networking Practice offers your statement beside the intro draft. Copy it into an
            interview story in the workspace, or read a posting against your lists on the
            Application Desk. Start from one experience when you want a story more than a reason.
          </p>
          <div
            class="mt-4 rounded-lg border border-foam/20 bg-foam/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--foam))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              Revisit your summary every three months. Your priorities shift more than you think.
            </p>
          </div>
        </article>
      </div>
    </section>
  </div>
</Base>
