---
import Base from '../layouts/Base.astro';
import PlateHeader from '../components/PlateHeader.astro';
import Career5Whys from '../components/Career5Whys';
import ErrorBoundary from '../components/shared/ErrorBoundary';
import GuideCoach from '../components/shared/GuideCoach';
import { siteConfig } from '../config/site';
import { ogImageFor } from '../config/og';

const pageUrl = new URL('/career/', siteConfig.siteUrl).toString();
const careerSchemas = [
  {
    '@context': 'https://schema.org',
    '@type': 'CreativeWork',
    '@id': `${pageUrl}#creativework`,
    url: pageUrl,
    name: 'Career Reflection · Five Whys',
    description:
      'Guided five whys exercise that chains each answer into the next question, tracing a career decision from surface reason to root reason.',
    inLanguage: 'en-US',
    author: {
      '@type': 'Person',
      name: siteConfig.author.name,
      url: siteConfig.author.url,
    },
    image: new URL(ogImageFor('/career/'), siteConfig.siteUrl).toString(),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: [
      {
        '@type': 'Question',
        name: 'What is the five whys exercise?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'The five whys is a simple way to dig past a surface answer. You ask "why" five times in a row, with each question building on what you just wrote, until you hit the actual reason behind your career decision.',
        },
      },
      {
        '@type': 'Question',
        name: 'Is my data stored securely?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Everything saves locally in your browser. Nothing gets sent to a server.',
        },
      },
      {
        '@type': 'Question',
        name: 'Can I export my reflection?',
        acceptedAnswer: {
          '@type': 'Answer',
          text: 'Yes. You can download your answers as a JSON file whenever you want.',
        },
      },
    ],
  },
];

const careerNoScriptContext = [
  "The Five Whys helps when a career question feels too fuzzy to act on, like whether to switch majors, apply for a different kind of job, leave a team, or figure out what kind of work fits you. You write down the first reason that comes to mind, then keep asking why until you hit the real constraint or tradeoff underneath it.",
  "The interactive tool gives you prompts, local saving, a summary built from your own words, and JSON export. Without JavaScript, you can do the exact same thing on paper: write down the surface reason, ask why that's true, repeat four more times, and turn the final answer into something concrete you can test.",
  'Specific answers are much more useful than dramatic ones. Stopping at "I want a better job" doesn\'t tell you what to apply for. Pushing down to "I want work where I explain things to people one on one, like I do when I tutor" or "I\'m avoiding this major because I like the writing classes, not the lab ones" gives you something you can use for your resume, intros, and interviews.',
  "A good test for your final answer is whether it changes what you do next. If it just repeats that you're frustrated, keep going. If it helps you rule out certain postings, pick a project to highlight, or decide who to talk to next, it's specific enough to act on.",
  "Because career notes often include real employers, coworkers, and personal worries, everything stays local in your browser. Look over any exported file before sharing it, and if your answers bring up a strong example from past work, carry that over to the Resume Game or Interview Workspace.",
];
---

<Base
  title="The Five Whys"
  description="Ask why five times on a career decision to get past the first obvious answer and figure out what really matters to you."
  breadcrumbs={[
    { label: 'Home', href: '/' },
    { label: 'Career Reflection', href: '/career/' },
  ]}
  structuredData={careerSchemas}
  noScriptContext={careerNoScriptContext}
>
  <div class="relative overflow-hidden px-4 pb-16 pt-4 sm:pt-6">
    <PlateHeader
      tag="Plate I · Reflect"
      roman="I"
      title="The Five Whys"
      description="Ask why five times until your answer stops changing. You end up with the real reason behind your first answer, in your own words, plus one way to test it."
      accent="foam"
    />
    <GuideCoach client:load tool="career" />
    <section id="why-flow" class="mx-auto w-full max-w-6xl">
      <ErrorBoundary client:load>
        <Career5Whys client:load showHeader={false} showFooter={false} className="pb-8" />
      </ErrorBoundary>
    </section>

    <section
      class="relative mx-auto mt-12 w-full max-w-6xl reveal"
      aria-labelledby="career-guide-heading"
    >
      <div class="mb-8 border-t border-border/40 pt-8">
        <span class="eyebrow" style="color: hsl(var(--foam))">How it works</span>
        <h2
          id="career-guide-heading"
          class="mt-3 text-2xl font-semibold tracking-tight text-foreground sm:text-3xl"
        >
          Dig past the first answer
        </h2>
      </div>

      <div class="grid gap-6 md:grid-cols-3 reveal-stagger">
        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-foam/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-foam/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-foam"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">Get to the actual reason</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            Five whys works well when your first answer sounds true, but it's still too vague to
            do anything with. Keep asking why until you land on a real constraint, skill, work
            setting, or tradeoff you can look for.
          </p>
          <div
            class="mt-4 rounded-lg border border-foam/20 bg-foam/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--foam))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              If your first answer is "more money," ask what that money lets you do. That next
              answer is usually what you're really after.
            </p>
          </div>
        </article>

        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-foam/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-foam/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-foam"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M8.242 5.992h12m-12 6h12m-12 6h12M3.75 6.75h.007v.008H3.75V6.75zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zM3.75 12h.007v.008H3.75V12zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm-.375 5.25h.007v.008H3.75v-.008zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">Turn answers into a checklist</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            Once you finish all five, click the phrases that sound most like you to pull your
            statement together. Then jot down two short lists: what a job has to offer, and what
            you're okay giving up.
          </p>
          <div
            class="mt-4 rounded-lg border border-foam/20 bg-foam/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--foam))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              Keep those two lists open when you read job postings or weigh an offer.
            </p>
          </div>
        </article>

        <article
          class="rounded-xl border border-border/50 bg-card/50 p-6 transition-colors duration-200 hover:border-foam/40 hover:bg-card/70"
        >
          <div
            class="mb-4 flex h-10 w-10 items-center justify-center rounded-xl bg-foam/15"
          >
            <svg
              aria-hidden="true"
              class="h-5 w-5 text-foam"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor"
              stroke-width="1.8"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99"
              ></path>
            </svg>
          </div>
          <h3 class="text-xl font-semibold text-foreground">Carry it into the other tools</h3>
          <p class="mt-3 text-sm leading-relaxed text-muted-foreground">
            Networking Practice shows your statement right next to your intro draft. You can also
            copy it into an interview story or compare a job posting against your lists on the
            Application Desk.
          </p>
          <div
            class="mt-4 rounded-lg border border-foam/20 bg-foam/6 p-3"
          >
            <p class="eyebrow" style="color: hsl(var(--foam))">Tip</p>
            <p class="mt-1.5 text-xs leading-relaxed text-muted-foreground">
              Check back on your saved snapshot in a few months to see if what you care about has
              changed.
            </p>
          </div>
        </article>
      </div>
    </section>
  </div>
</Base>
