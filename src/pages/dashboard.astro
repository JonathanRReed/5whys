---
import PlateHeader from '../components/PlateHeader.astro';
import Base from '../layouts/Base.astro';
import CareerDashboard from '../components/CareerDashboard';

const noScriptContext = [
  "The dashboard needs JavaScript to read what you've saved in this browser across the tools and show it in one place: resume scores and skills, saved five whys reflections, interview stories, and networking practice rounds, along with a suggested next step. Nothing loads from a server and there's no account behind it.",
  "If you haven't used any tools yet, the dashboard starts empty. You can open any tool directly or run the career review to pick where to start.",
];
---

<Base
  title="Dashboard · 5 Whys Career Studio"
  description="See everything you've saved locally across the 5 Whys tools, including resume scores, reflections, stories, and next steps."
  noScriptContext={noScriptContext}
>
  <div class="relative mx-auto w-full max-w-6xl px-4 pb-16 pt-4 sm:pt-6">
    <PlateHeader
      tag="The studio · Your work"
      roman=""
      title="Dashboard"
      description="Everything you've saved on this device across the tools, plus what to work on next. Nothing here comes from a server."
      accent="foam"
    />
    <CareerDashboard client:load />
  </div>
</Base>
