---
import PlateHeader from '../components/PlateHeader.astro';
import Base from '../layouts/Base.astro';
import CareerDashboard from '../components/CareerDashboard';

const noScriptContext = [
  'The dashboard on this page requires JavaScript. It reads the work you have saved in this browser across the tools and summarizes it in one place: resume bullet scores and detected skills, saved five whys reflections, interview stories, and networking practice rounds, with a suggested next step drawn from that saved work. Nothing is loaded from a server and there is no account or profile behind it.',
  'If you have not used the tools yet, the dashboard is empty. Start with any tool directly, or use the career review page to pick a starting point.',
];
---

<Base
  title="Dashboard · 5 Whys Career Studio"
  description="Your unified career progress dashboard. See scores, skills, recent activity, and recommended next steps across all tools."
  noScriptContext={noScriptContext}
>
  <div class="relative mx-auto w-full max-w-6xl px-4 pb-16 pt-4 sm:pt-6">
    <PlateHeader
      tag="The studio · Your work"
      roman=""
      title="Dashboard"
      description="What you have saved on this device across the tools, and what to do next. Nothing here is loaded from a server."
      accent="foam"
    />
    <CareerDashboard client:load />
  </div>
</Base>
