dist/
# generated types
.astro/

# dependencies
node_modules/

# local dev and CI use bun (bun.lock). package-lock.json is committed on
# purpose: Cloudflare Pages only detects bun.lockb, not the text-format
# bun.lock, so without a package-lock.json it falls back to a bare
# `npm install` that crashes on this dependency graph.
yarn.lock
pnpm-lock.yaml

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*


# environment variables
.env
.env.production

